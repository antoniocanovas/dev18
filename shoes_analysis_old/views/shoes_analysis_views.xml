<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List -->
    <record id="view_shoes_analysis_list" model="ir.ui.view">
        <field name="name">shoes.analysis.list</field>
        <field name="model">shoes.analysis</field>
        <field name="arch" type="xml">
            <list string="Shoes Analysis">
                <header>
                    <button name="update_shoes_analysis"
                            string="Update"
                            type="object"
                            class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="shoes_campaign_id"/>
                <field name="shoes_campaign_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_shoes_analysis_form" model="ir.ui.view">
        <field name="name">shoes.analysis.form</field>
        <field name="model">shoes.analysis</field>
        <field name="arch" type="xml">
            <form string="Shoes Analysis">
                <header/>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="update_shoes_analysis"
                                string="Update"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-refresh"/>
                        <button name="action_print_report"
                                type="object"
                                string="Imprimir"
                                class="oe_stat_button"
                                icon="fa-print"
                                invisible="not analysis_html"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Analysis Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shoes_campaign_id"/>
                            <field name="shoes_campaign_ids" widget="many2many_tags"
                                   invisible="type in ['campaign_last_ranking','campaign_product_ranking']"/>
                            <field name="partner_id"
                                   invisible="type != 'customer_comparison'"
                                   required="type == 'customer_comparison'"/>
                            <field name="referrer_id"
                                   string="Representante"
                                   invisible="type != 'salesman_model'"
                                   required="type == 'salesman_model'"/>
                            <field name="type" groups="base.group_no_one" readonly="1"/>
                            <field name="write_date"/>
                        </group>
                        <group>
                            <field name="resume_html" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report">
                            <field name="analysis_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Product Ranking" invisible="type not in ['product_ranking', 'campaign_product_ranking']">
                            <field name="ranking_line_ids">
                                <list>
                                    <field name="ranking"/>
                                    <field name="image" widget="image" options="{'size':[0,90]}"/>
                                    <field name="product_tmpl_id"/>
                                    <field name="shoes_model_material_id"/>
                                    <field name="shoes_last_id" column_invisible="1"/>
                                    <field name="pairs_count_sale"/>
                                    <field name="pairs_count_cancel"/>
                                    <field name="pairs_count_net"/>
                                    <field name="sale_net_amount" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Last Ranking" invisible="type not in ['last_ranking', 'campaign_last_ranking']">
                            <field name="ranking_line_ids">
                                <list>
                                    <field name="ranking"/>
                                    <field name="shoes_last_id"/>
                                    <field name="pairs_count_sale"/>
                                    <field name="pairs_count_cancel"/>
                                    <field name="pairs_count_net"/>
                                    <field name="sale_net_amount" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción 1: Situación de ventas y entregas por agente -->
    <record id="action_sales_delivery_by_agent" model="ir.actions.act_window">
        <field name="name">Situación de ventas y entregas por agente</field>
        <field name="res_model">shoes.analysis</field>
        <field name="context">{'default_type': 'salesman_sales_delivery'}</field>
        <field name="domain">[('type','=','salesman_sales_delivery')]</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Acción 2: Ventas por representante y país -->
    <record id="action_sales_by_rep_country" model="ir.actions.act_window">
