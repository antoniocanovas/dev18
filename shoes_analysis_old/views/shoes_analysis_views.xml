        <field name="res_model">shoes.analysis</field>
        <field name="context">{'default_type': 'last_ranking'}</field>
        <field name="domain">[('type','=','last_ranking')]</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Acción 13: Ranking de hormas por campaña con modelos y colores -->
    <record id="action_campaign_last_ranking" model="ir.actions.act_window">
        <field name="name">Ranking de hormas por campaña con modelos y colores</field>
        <field name="res_model">shoes.analysis</field>
