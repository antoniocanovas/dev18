    </record>

    <!-- Acción 8: Ranking de productos por campaña con colores -->
    <record id="action_campaign_product_ranking" model="ir.actions.act_window">
        <field name="name">Ranking de productos por campaña con colores</field>
        <field name="res_model">shoes.analysis</field>
