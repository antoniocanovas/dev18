<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Purchase Lot Preassignment Label PDF Reports -->
        
        <!-- Default 4x12 Report -->
        <record id="action_report_preassignment_label" model="ir.actions.report">
            <field name="name">Preassignment Labels (PDF)</field>
            <field name="model">purchase.lot.preassignment</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">purchase_lot_preassignment.report_preassignment_label</field>
            <field name="report_file">purchase_lot_preassignment.report_preassignment_label</field>
            <field name="paperformat_id" ref="product.paperformat_label_sheet"/>
            <field name="print_report_name">'Preassignment Labels - %s' % object.purchase_order_id.name</field>
            <field name="binding_model_id" ref="model_purchase_lot_preassignment"/>
            <field name="binding_type">report</field>
        </record>

        <!-- 4x12 Format Report -->
        <record id="action_report_preassignment_label_4x12" model="ir.actions.report">
