<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <!-- ZPL Template for Purchase Lot Preassignment Labels -->
    <template id="label_zpl_template">
        <t t-foreach="docs" t-as="o">
            <t t-translation="off">
^XA^CI28
^FO50,50
^A0N,36,28^FD<t t-out="o.product_id.default_code or o.product_id.name[:20]"/>^FS
^FO50,90
^A0N,28,22^FD<t t-out="o.product_id.name[:30]"/>^FS
^FO50,130
^A0N,40,30^FDLOT/SN: <t t-out="o.name"/>^FS
^FO50,180
^A0N,24,18^FDPO: <t t-out="o.purchase_order_id.name"/>^FS
^FO50,210
^A0N,20,16^FDState: <t t-out="dict(o._fields['state'].selection)[o.state]"/>^FS
<t t-if="o.product_qty > 1">
^FO50,240
^A0N,20,16^FDQty: <t t-out="o.product_qty"/>^FS
</t>
^FO50,270
^BY2
^BCN,60,Y,N,N
^FD<t t-out="o.name"/>^FS
^XZ
            </t>
        </t>
    </template>
</data>
</odoo>