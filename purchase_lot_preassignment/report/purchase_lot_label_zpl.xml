<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ZPL Template for Zebra Printers -->
        <template id="label_lot_zpl_template">
            <t t-foreach="docs" t-as="lot">^XA

^FO50,50^A0N,40,40^FD<t t-esc="lot.product_id.default_code or ''"/>^FS
^FO50,100^A0N,30,30^FD<t t-esc="lot.product_id.name"/>^FS

^FO50,150^A0N,50,50^FDL/S: <t t-esc="lot.name"/>^FS

<t t-if="lot.ref">^FO50,210^A0N,25,25^FDRef: <t t-esc="lot.ref"/>^FS
</t>

^FO50,250^BY2^BCN,100,Y,N,N^FD<t t-esc="lot.name"/>^FS

^XZ
</t>
        </template>
    </data>
</odoo>
