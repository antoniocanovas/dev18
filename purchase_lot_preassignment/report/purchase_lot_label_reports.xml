<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Stock Lot Label PDF Reports -->

        <!-- Default 4x12 Report -->
        <record id="action_report_lot_label" model="ir.actions.report">
            <field name="name">Lot/SN Labels (PDF)</field>
            <field name="model">stock.lot</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">purchase_lot_preassignment.report_lot_label</field>
            <field name="report_file">purchase_lot_preassignment.report_lot_label</field>
            <field name="paperformat_id" ref="product.paperformat_label_sheet"/>
            <field name="print_report_name">'Lot Labels - %s' % object.name</field>
            <field name="binding_model_id" ref="stock.model_stock_lot"/>
            <field name="binding_type">report</field>
        </record>

        <!-- 4x12 Format Report -->
        <record id="action_report_lot_label_4x12" model="ir.actions.report">
