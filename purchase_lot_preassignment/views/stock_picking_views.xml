<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Stock Picking Form View Extension -->
    <record id="view_picking_form" model="ir.ui.view">
        <field name="name">stock.picking.form.lot.preassignment</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!-- Add only_preassigned_lots field -->
            <xpath expr="//field[@name='move_ids_without_package']" position="before">
                <group name="lot_options" invisible="picking_type_code != 'incoming' or not purchase_id">
                    <field name="only_preassigned_lots"
                           help="If checked, only preassigned lots/serial numbers will be allowed during reception"/>
                </group>
            </xpath>

            <!-- Add button in header for incoming pickings -->
            <xpath expr="//button[@name='button_validate']" position="before">
                <button name="action_view_expected_lots"
                        type="object"
                        string="Expected Lots"
                        class="btn-secondary"
                        help="View expected lots from purchase order"
                        invisible="picking_type_code != 'incoming' or not purchase_id"/>
            </xpath>

        </field>
    </record>

</odoo>
