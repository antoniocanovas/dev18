<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_view_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Añadir el botón después del botón de sale orders si existe -->
            <xpath expr="//button[@name='action_view_sale_orders']" position="after">
                <button type="object"
                        name="action_view_associated_lots"
                        string="Etiquetas"
                        class="oe_stat_button"
                        icon="fa-print">
                </button>
            </xpath>
        </field>
    </record>
</odoo>
