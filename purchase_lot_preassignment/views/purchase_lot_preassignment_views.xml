<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Lot Preassignment List View -->
    <record id="view_purchase_lot_preassignment_list" model="ir.ui.view">
        <field name="name">purchase.lot.preassignment.list</field>
        <field name="model">purchase.lot.preassignment</field>
        <field name="arch" type="xml">
            <list string="Lot Preassignments"
                  decoration-success="state == 'confirmed'"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'received'"
                  decoration-muted="state == 'canceled'">
                <header>
                    <button name="action_open_label_layout"
                            type="object"
                            string="Print Labels"
                            class="btn-primary"
                            icon="fa-print"/>
                </header>
                <field name="sequence"/>
                <field name="purchase_order_id"/>
                <field name="purchase_line_id"/>
                <field name="product_id"/>
                <field name="name"/>
                <field name="product_qty"/>
                <field name="tracking" column_invisible="1"/>
                <field name="state" widget="badge"/>
                <field name="date_created"/>
                <field name="date_received" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Purchase Lot Preassignment Form View -->
    <record id="view_purchase_lot_preassignment_form" model="ir.ui.view">
        <field name="name">purchase.lot.preassignment.form</field>
        <field name="model">purchase.lot.preassignment</field>
        <field name="arch" type="xml">
            <form string="Lot Preassignment">
                <header>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_stock_lot"
                            type="object"
                            string="Create Stock Lot"
                            class="btn-secondary"
                            invisible="stock_lot_id or state == 'canceled'"/>
                    <button name="action_open_label_layout"
                            type="object"
                            string="Print Labels"
                            class="btn-secondary"
                            icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,received"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_create_stock_lot"
                                class="oe_stat_button"
                                icon="fa-cube"
                                invisible="not stock_lot_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Stock Lot</span>
                            </div>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="tracking == 'serial'"/>
                            <field name="tracking" invisible="1"/>
                        </group>
                        <group>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="purchase_line_id" readonly="1"/>
                            <field name="stock_lot_id" readonly="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>

                    <group string="Dates" groups="base.group_no_one">
                        <group>
                            <field name="date_created" readonly="1"/>
                            <field name="date_confirmed" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_received" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Purchase Lot Preassignment Search View -->
    <record id="view_purchase_lot_preassignment_search" model="ir.ui.view">
        <field name="name">purchase.lot.preassignment.search</field>
        <field name="model">purchase.lot.preassignment</field>
        <field name="arch" type="xml">
            <search string="Lot Preassignments">
                <field name="name"/>
                <field name="product_id"/>
                <field name="purchase_order_id"/>
                <field name="purchase_line_id"/>

                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter name="received" string="Received" domain="[('state', '=', 'received')]"/>

                <separator/>
                <filter name="serial" string="Serial Numbers" domain="[('tracking', '=', 'serial')]"/>
                <filter name="lot" string="Lots" domain="[('tracking', '=', 'lot')]"/>

                <group expand="0" string="Group By">
                    <filter name="group_purchase_order" string="Purchase Order"
                            context="{'group_by': 'purchase_order_id'}"/>
                    <filter name="group_product" string="Product"
                            context="{'group_by': 'product_id'}"/>
                    <filter name="group_state" string="Status"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_tracking" string="Tracking Type"
                            context="{'group_by': 'tracking'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Purchase Lot Preassignment Action -->
    <record id="action_purchase_lot_preassignment" model="ir.actions.act_window">
        <field name="name">Lot Preassignments</field>
        <field name="res_model">purchase.lot.preassignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_purchase_lot_preassignment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No lot preassignments found!
            </p>
            <p>
                Lot preassignments are automatically created from purchase orders
                for products with lot/serial tracking.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_purchase_lot_preassignment"
              name="Lot Preassignments"
              parent="purchase.menu_procurement_management"
              action="action_purchase_lot_preassignment"
              sequence="50"/>

</odoo>
