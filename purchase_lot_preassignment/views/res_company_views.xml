<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_lot_preassignment_company_form" model="ir.ui.view">
        <field name="name">purchase.lot.preassignment.company.form</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="Lot Preassignment" name="lot_preassignment">
                    <group string="Purchase">
                        <field name="purchase_all_sale"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
