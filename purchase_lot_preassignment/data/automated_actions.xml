<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción automática 1: Crear lotes de pedidos confirmados -->
    <record id="action_create_lots_on_sale_confirm" model="ir.actions.server">
        <field name="name">Crear lotes de pedidos confirmados</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
record.create_lots_for_sale_order()
]]></field>
    </record>

    <record id="base_automation_create_lots_on_sale_confirm" model="base.automation">
        <field name="name">Crear lotes de pedidos confirmados</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="trigger">on_write</field>
        <field name="trigger_field_ids" eval="[(6, 0, [ref('sale.field_sale_order__state')])]"/>
        <field name="filter_pre_domain">[('state', '!=', 'sale')]</field>
        <field name="filter_domain">[('state', '=', 'sale')]</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_create_lots_on_sale_confirm')])]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Acción automática 2: Reservar SN específico al recibir compra -->
    <record id="action_reserve_sn_on_receipt" model="ir.actions.server">
        <field name="name">Reservar SN específico al recibir compra</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="state">code</field>
        <field name="code">record._reserve_lot_for_sale_order()</field>
    </record>

    <record id="base_automation_reserve_sn_on_receipt" model="base.automation">
        <field name="name">Reservar SN específico al recibir compra</field>
        <field name="model_id" ref="stock.model_stock_move_line"/>
        <field name="trigger">on_write</field>
        <field name="filter_domain">[('state', '=', 'done')]</field>
        <field name="action_server_ids" eval="[(6, 0, [ref('action_reserve_sn_on_receipt')])]"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
