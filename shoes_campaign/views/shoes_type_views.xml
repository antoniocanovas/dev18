<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ACCIONES DE VENTANA: -->
    <record id="shoes_type_act_window" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="filter" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="limit">80</field>
        <field name="name">Shoes Type</field>
        <field name="res_model">shoes.type</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list</field>
    </record>

    <!-- SHOES TYPE INVENTORY CONFIG MENU: -->
    <record id="shoes_type_menu" model="ir.ui.menu">
        <field name="action" ref="shoes_type_act_window"/>
        <field name="active" eval="True"/>
        <field name="name">Shoes Type</field>
        <field name="parent_id" ref="shoes_dealer.shoes_dealer_configuration_details"/>
        <field name="sequence">120</field>
        <field name="web_icon" eval="False"/>
    </record>

    <!-- TREE VIEW: -->
    <record id="shoes_type_default_tree" model="ir.ui.view">
        <field name="name">shoes.type.default.tree</field>
        <field name="model">shoes.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">list</field>
    </record>

</odoo>
