<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_campaign_inh_form" model="ir.ui.view">
        <field name="name">shoes.campaign.inh.form</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_dealer.shoes_dealer_inh_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='shoes_attributes']" position="inside">
                <field name="shoes_sufix_model_code_prefix"/>
            </xpath>
        </field>
    </record>

</odoo>
