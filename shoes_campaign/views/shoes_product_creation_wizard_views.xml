<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shoes_product_creation_wizard_form" model="ir.ui.view">
        <field name="name">shoes.product.creation.wizard.form</field>
        <field name="model">shoes.product.creation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" readonly="1"/>
                    <field name="task_id" readonly="1"/>
                    <field name="shoes_campaign_id" readonly="1"/>
                    <field name="manufacturer_id" readonly="1"/>
                    <field name="material_ids"
                           domain="[('id','in',pending_product_material_ids)]"
                           options="{'no_create':true, 'no_create_edit':true}"
                    />
                    <field name="pending_product_material_ids" widget="many2many_tags" invisible="1"/>
                </group>
                <footer>
                <button
                        name="action_apply"
                        class="btn btn-primary"
                        string="Create"
                        type="object"
                    />
                or
                <button special="cancel" class="btn btn-secondary" string="Cancel" />
            </footer>
            </form>
        </field>
    </record>

    <record id="shoes_product_creation_wizard_action_window" model="ir.actions.act_window">
        <field name="name">Product creation</field>
        <field name="res_model">shoes.product.creation.wizard</field>
        <field name="view_id" ref="shoes_product_creation_wizard_form" />
        <field name="context">{'task_id': active_id}</field>
        <field name="target">new</field>
    </record>

</odoo>
