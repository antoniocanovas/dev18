<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shoes_product_creation_wizard_form" model="ir.ui.view">
        <field name="name">shoes.product.creation.wizard.form</field>
        <field name="model">shoes.product.creation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" readonly="1"/>
                    <field name="task_id" readonly="1"/>
                    <field name="shoes_campaign_id" readonly="1"/>
                    <field name="manufacturer_id" readonly="1"/>
                    <field name="material_ids"
                           domain="[('id','in',shoes_model_material_ids),('shoes_product_tmpl_id','=',False)]"
                           options="{'no_create':true, 'no_create_edit':true}"
                    />
                    <field name="shoes_model_material_ids"/>
                </group>
                <footer>
                <button
                        name="action_apply"
                        class="btn btn-primary"
                        string="Create"
                        type="object"
                    />
                or
                <button special="cancel" class="btn btn-secondary" string="Cancel" />
            </footer>
            </form>
        </field>
    </record>

</odoo>
