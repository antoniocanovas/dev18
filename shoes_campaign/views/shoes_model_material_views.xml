<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- list VIEW: -->
    <record id="shoes_model_material_default_list" model="ir.ui.view">
        <field name="name">shoes.model.material.default.list</field>
        <field name="model">shoes.model.material</field>
        <field name="arch" type="xml">
            <list create="False" edit="False">
                <field name="name"/>
                <field name="shoes_last_id" required="1" options="{'no_create':true, 'no_create_edit':true}"/>
                <field name="material_id" required="1" options="{'no_create':true, 'no_create_edit':true}"
                       optional="hide"/>
                <field name="manufacturer_ref" required="1" optional="hide"/>
                <field name="shoes_product_tmpl_id" optional="hide" readonly="1"/>
                <field name="task_id" optional="hide" readonly="1"/>
                <field name="shoes_campaign_id" optional="hide"/>
            </list>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">list</field>
    </record>

</odoo>
