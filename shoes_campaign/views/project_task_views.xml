<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Task customization : -->
    <record id="shoes_campaign_task_inh_form" model="ir.ui.view">
        <field name="name">shoes.dealer.campaign.task.inh.form</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <data>

                <xpath expr="//header" position="inside">
                    <button
                            name="shoes_create_product"
                            invisible="not is_shoes_campaign"
                            string="Create product"
                            type="object"
                            groups="project.group_project_user"
                    >
                    </button>
                </xpath>

                <xpath expr="//page[@name='description_page']" position="before">
                    <page name="shoes_dealer_campaign" invisible="not is_shoes_campaign" string="Shoe model">
                        <group name="shoes_dealer_campaign" invisible="not is_shoes_campaign">
                            <group>
                                <field name="trade_name"/>
                                <field name="shoes_product_tmpl_id" readonly="1"/>
                                <field name="product_brand_id"/>
                                <field name="code" readonly="code"/>
                                <field name="manufacturer_id"
                                       readonly="shoes_material_id or shoes_last_id"
                                       options="{'no_create':true, 'no_create_edit':true}" force_save="1"/>
                                <field name="shoes_material_id"
                                       options="{'no_create':true, 'no_create_edit':true}"/>
                                <field name="gender"/>
                                <field name="product_categ_id"/>
                                <field name="displayed_image_id" options="{'no_create': True}"
                                       domain="[('res_model','=','project.task'),('res_id','=',id),('mimetype','ilike','image')]"
                                />
                                <field name="shoes_last_id"
                                       domain="[('manufacturer_id','=',manufacturer_id)]"
                                />
                                <field name="shoes_manufacturer_ref"/>
                            </group>
                            <group>
                                <field name="displayed_image" widget="tablet_image" options='{"size":[200]}' nolabel="1"/>
                            </group>
                        </group>

                        <group name="model_exwork" string="Exwork">
                            <group name="model_exwork_left"/>
                            <group name="model_exwork_right">
                                <field name="exwork" widget="monetary" options="{'currency_field':'exwork_currency_id'}"/>
                            </group>
                            <field name="exwork_currency_id" invisible="1"/>
                        </group>

                        <group name="model_addtional_info" string="Additional info">
                            <group>
                                <field name="intrastat_duty_id"/>
                                <field name="shoes_pair_weight_id"/>
                            </group>
                            <group>
                                <field name="shoes_url" widget="url"/>
                                <field name="shoes_model_material"/>
                            </group>
                        </group>
                    </page>

                    <page name="shoes_campaign_details" invisible="not is_shoes_campaign" string="Shoe details">
                        <group name="shoes_model_details" invisible="not is_shoes_campaign">
                            <group name="shoes_detail_left">
                                <field name="shoes_type"/>
                                <field name="shoes_closure_id"/>
                                <field name="shoes_material_main_id" options="{'no_create':true, 'no_create_edit':true}"/>
                                <field name="shoes_material_external1_id"
                                       options="{'no_create':true, 'no_create_edit':true}"/>
                                <field name="shoes_material_external1_percent"/>
                                <field name="shoes_material_external2_id"
                                       options="{'no_create':true, 'no_create_edit':true}"/>
                                <field name="shoes_material_external2_percent"/>
                            </group>
                            <group name="shoes_detail_right">
                                <field name="shoes_material_lin_internal1_id"
                                       options="{'no_create':true, 'no_create_edit':true}"/>
                                <field name="shoes_material_lin_internal1_percent"/>
                                <field name="shoes_material_lin_internal2_id"
                                       options="{'no_create':true, 'no_create_edit':true}"/>
                                <field name="shoes_material_lin_internal2_percent"/>
                                <field name="shoes_height"/>
                                <field name="shoes_shalft_categ"/>
                                <field name="shoes_with"/>
                            </group>
                        </group>
                        <field name="is_shoes_campaign" invisible="1"/>
                    </page>
                </xpath>
                <xpath expr="//label[@for='date_deadline']" position="before">
                    <field name="shoes_default_code_prefix" class="h2"/>
                    <field name="shoes_default_code_sufix" class="h2"/>
                </xpath>
            </data>

        </field>
        <field name="priority">99</field>
    </record>

    <record id="view_task_kanban_inherit_shoes" model="ir.ui.view">
        <field name="name">project.task.kanban.inherit.shoes</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban[1]" position="inside">
                <field name="project_ribbon_label"/>
            </xpath>
            <xpath expr="//kanban[1]/templates[1]/t[@t-name='card']/main[1]" position="before">
                <t t-if="record.project_ribbon_label.raw_value">
                    <div class="ribbon ribbon-top-right">
                        <span class="text-bg-warning">
                            <t t-esc="record.project_ribbon_label.value"/>
                        </span>
                    </div>
                </t>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='displayed_image_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='displayed_image_id']" position="after">
                <div class="o_shoes_kanban_image_container">
                    <field name="displayed_image" widget="tablet_image" options='{"size": [0, 150]}' nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//kanban" position="inside">
                <style>
                    .o_shoes_kanban_image_container {
                        height: 150px;
                        width: 100%;
                        overflow: hidden;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }
                    .o_shoes_kanban_image_container img {
                        height: 100%;
                        width: 100%;
                        object-fit: cover;
                    }
                </style>
            </xpath>
        </field>
    </record>

    <record id="shoes_campaign_task_inh_list_view" model="ir.ui.view">
        <field name="name">shoes.campaign.task.inh.list.view</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="before">
                <field name="displayed_image" widget="image" options='{"size": [0, 50]}' string="Image"/>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="product_brand_id" optional="hide"/>
                <field name="shoes_product_tmpl_id" optional="hide"/>
                <field name="code" optional="hide"/>
                <field name="manufacturer_id" optional="hide"/>
                <field name="shoes_material_id" optional="hide"/>
                <field name="gender" optional="hide"/>
                <field name="product_categ_id" optional="hide"/>
                <field name="shoes_last_id" optional="hide"/>
                <field name="exwork" optional="hide"/>
                <field name="intrastat_duty_id" optional="hide"/>
                <field name="shoes_pair_weight_id" optional="hide"/>
                <field name="shoes_url" optional="hide"/>
                <field name="shoes_model_material" optional="hide"/>
                <field name="shoes_default_code_prefix" optional="hide"/>
                <field name="shoes_default_code_sufix" optional="hide"/>

            </xpath>
        </field>
    </record>

    <record id="shoes_campaign_task_kanban_models" model="ir.ui.view">
        <field name="name">shoes.campaign.task.kanban.models</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="quick_create">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="shoes_campaign_task_inh_search" model="ir.ui.view">
        <field name="name">shoes.campaign.task.inh.search</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//search/field[last()]" position="after">
                <field name="product_brand_id" string="Brand"/>
            </xpath>
            <xpath expr="//search/group" position="before">
                <filter name="group_by_brand" string="Brand"
                        context="{'group_by': 'product_brand_id'}"/>
            </xpath>
        </field>
    </record>

    <!-- Override standard task actions to also show tasks whose product
         is sold in the current campaign (via sale_campaign_ids). -->
    <record id="project.act_project_project_2_project_task_all" model="ir.actions.act_window">
        <field name="domain">[('sale_campaign_ids', 'in', [active_id])]</field>
    </record>

    <record id="project.dblc_proj" model="ir.actions.act_window">
        <field name="domain">[('sale_campaign_ids', 'in', [active_id])]</field>
    </record>

</odoo>
