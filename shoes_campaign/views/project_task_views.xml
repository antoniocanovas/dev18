<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- WIZARD creación de productos (window action): -->
    <record id="shoes_product_creation_wizard_action_window" model="ir.actions.act_window">
        <field name="name">Product creation</field>
        <field name="res_model">shoes.product.creation.wizard</field>
        <field name="view_id" ref="shoes_product_creation_wizard_form"/>
        <field name="context">{'default_task_id':active_id}</field>
        <field name="target">new</field>
    </record>

    <!-- Task customization : -->
    <record id="shoes_campaign_task_inh_form" model="ir.ui.view">
        <field name="name">shoes.dealer.campaign.task.inh.form</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <data>

                <xpath expr="//header" position="inside">
                    <button
                            name="%(shoes_campaign.shoes_product_creation_wizard_action_window)s"
                            invisible="not is_shoes_campaign"
                            string="Products creation"
                            type="action"
                            groups="project.group_project_user"
                    >
                    </button>
                </xpath>

                <xpath expr="//field[@name='description']" position="before">
                    <group name="shoes_dealer_campaign" invisible="not is_shoes_campaign">
                        <group>
                            <field name="product_brand_id"/>
                            <field name="code" readonly="code"/>
                            <field name="manufacturer_id" readonly="shoes_model_material_ids"
                                   options="{'no_create':true, 'no_create_edit':true}" force_save="1"/>
                            <field name="product_categ_id"/>
                            <field name="displayed_image_id" options="{'no_create': True}"
                                   domain="[('res_model','=','project.task'),('res_id','=',id),('mimetype','ilike','image')]"/>
                            <field name="gender"/>
                            <field name="shoes_pair_weight_id"/>
                            <field name="intrastat_duty_id"/>
                            <field name="exwork" widget="monetary" options="{'currency_field':'exwork_currency_id'}"/>
                        </group>
                        <group>
                            <field name="displayed_image" widget="tablet_image" options='{"size":[200]}' nolabel="1"/>
                        </group>
                    </group>

                    <group name="material_variants" string="Material variants" invisible="not is_shoes_campaign">
                        <field name="shoes_model_material"/>
                        <field name="shoes_manufacturer_ref"/>
                        <field name="shoes_material_id" options="{'no_create':true, 'no_create_edit':true}"/>
                        <field name="shoes_last_id" options="{'no_create':true, 'no_create_edit':true}"/>
                        <field name="shoes_product_tmpl_id" readonly="1"/>
                        <field name="shoes_url" widget="url"/>
                    </group>
                    <group string="Histórico para eliminar">
                        # Para eliminar una vez migrados datos:
                        <field name="shoes_default_last_id"/>
                        <field name="shoes_model_material_ids" readonly="not manufacturer_id"
                               invisible="not is_shoes_campaign"
                               context="{'default_shoes_last_id':shoes_default_last_id}" nolabel="1">
                            <list editable="bottom">
                                <field name="name" optional="show" readonly="1" string="Model code"/>
                                <field name="material_id" required="1"
                                       options="{'no_create':true, 'no_create_edit':true}"/>
                                <field name="shoes_last_id" required="1"
                                       options="{'no_create':true, 'no_create_edit':true}"/>
                                <field name="manufacturer_ref" required="1"/>
                                <field name="shoes_product_tmpl_id" readonly="1" optional="show"/>
                                <field name="shoes_url" widget="url" optional="show"/>
                                <field name="task_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                    # Eliminar hasta aquí.

                    <group name="shoes_model_details" string="Shoes details" invisible="not is_shoes_campaign">
                        <group name="shoes_detail_left">
                            <field name="shoes_type"/>
                            <field name="shoes_closure_id"/>
                            <field name="shoes_material_main_id" options="{'no_create':true, 'no_create_edit':true}"/>
                            <field name="shoes_material_external1_id"
                                   options="{'no_create':true, 'no_create_edit':true}"/>
                            <field name="shoes_material_external1_percent"/>
                            <field name="shoes_material_external2_id"
                                   options="{'no_create':true, 'no_create_edit':true}"/>
                            <field name="shoes_material_external2_percent"/>
                        </group>
                        <group name="shoes_detail_right">
                            <field name="shoes_material_lin_internal1_id"
                                   options="{'no_create':true, 'no_create_edit':true}"/>
                            <field name="shoes_material_lin_internal1_percent"/>
                            <field name="shoes_material_lin_internal2_id"
                                   options="{'no_create':true, 'no_create_edit':true}"/>
                            <field name="shoes_material_lin_internal2_percent"/>
                            <field name="shoes_height"/>
                            <field name="shoes_shalft_categ"/>
                            <field name="shoes_with"/>
                        </group>
                    </group>
                    <field name="is_shoes_campaign" invisible="1"/>
                    <field name="exwork_currency_id" invisible="1"/>
                </xpath>
                <xpath expr="//label[@for='date_deadline']" position="before">
                    <field name="shoes_default_code_prefix" class="h2"/>
                    <field name="shoes_default_code_sufix" class="h2"/>
                </xpath>
            </data>

        </field>
        <field name="priority">99</field>
    </record>

</odoo>
