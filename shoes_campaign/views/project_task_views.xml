<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- WIZARD creación de productos (window action): -->
    <record id="shoes_product_creation_wizard_action_window" model="ir.actions.act_window">
        <field name="name">Product creation</field>
        <field name="res_model">shoes.product.creation.wizard</field>
        <field name="view_id" ref="shoes_product_creation_wizard_form" />
        <field name="context">{'task_id':active_id}</field>
        <field name="target">new</field>
    </record>

    <!-- Task customization : -->
    <record id="shoes_campaign_task_inh_form" model="ir.ui.view">
        <field name="name">shoes.dealer.campaign.task.inh.form</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//header" position="inside">
                    <button
                            name="shoes_product_creation_wizard_action_window"
                            invisible="not is_shoes_campaign"
                            string="Products creation"
                            groups="project.group_project_user"
                            type="action"
                            context="{'default_task_id':id}"
                    >
                    </button>
                </xpath>

                <xpath expr="//field[@name='description']" position="before">
                    <group name="shoes_dealer_campaign" invisible="not is_shoes_campaign">
                        <group>
                            <field name="product_brand_id"/>
                            <field name="code" readonly="code"/>
                            <field name="manufacturer_id" readonly="shoes_model_material_ids" force_save="1"/>
                        </group>
                        <group>
                            <field name="shoes_last_id"/>
                            <field name="gender"/>
                            <field name="shoes_pair_weight_id"/>
                            <field name="intrastat_duty_id"/>
                        </group>

                        <group name="material_last_manufacturer-ref">
                            <field name="shoes_model_material_ids" invisible="not manufacturer_id">
                                <list editable="bottom">
                                    <field name="material_id" required="1" options="{'no_create':true, 'no_create_edit':true}"/>
                                    <field name="shoes_last_id" required="1" options="{'no_create':true, 'no_create_edit':true}"/>
                                    <field name="name" required="1"/>
                                    <field name="shoes_product_tmpl_id" readonly="1" optional="show"/>
                                    <field name="task_id" column_invisible="1"/>
                                </list>
                            </field>
                        </group>
                        <field name="is_shoes_campaign" invisible="1"/>
                    </group>

                </xpath>
            </data>

        </field>
        <field name="priority">99</field>
    </record>

</odoo>
