<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- VISTA SOLO PT: -->
    <record id="shoes_intrastat_duty_pt_only_inh_form" model="ir.ui.view">
        <field name="name">shoes.intrastat.duty.pt.only.inh.form</field>
        <field name="model">product.template</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_dealer.shoes_dealer_product_inh_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- Campo para estimación de costes intrastat para el par: -->
            <xpath expr="//field[@name='exwork_single_euro']" position="after">
                <field name="intrastat_duty_id"/>
                <field name="estimated_pair_landed_cost"/>
            </xpath>
        </field>
    </record>

</odoo>