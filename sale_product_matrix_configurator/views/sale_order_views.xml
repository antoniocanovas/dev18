<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Extend Sale Order Form View to add configurator mode -->
    <record id="view_order_form_configurator_mode" model="ir.ui.view">
        <field name="name">sale.order.form.configurator.mode</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_product_matrix.view_order_form_with_variant_grid"/>
        <field name="arch" type="xml">
            
            <!-- Add configurator_mode field after product_add_mode -->
            <xpath expr="//list/field[@name='product_add_mode']" position="after">
                <field name="configurator_mode" 
                       column_invisible="not parent.state in ['draft', 'sent'] or not product_template_id or not product_template_id.attribute_line_ids"
                       readonly="parent.state not in ['draft', 'sent']"/>
            </xpath>
            
            <!-- Add configurator button -->
            <xpath expr="//list/field[@name='configurator_mode']" position="after">
                <button name="action_open_product_configurator" 
                        type="object" 
                        icon="fa-cogs" 
                        title="Open Product Configurator"
                        column_invisible="not parent.state in ['draft', 'sent']"
                        invisible="configurator_mode != 'configurator' or not product_template_id or not product_template_id.attribute_line_ids"
                        class="btn-link"/>
            </xpath>
            
        </field>
    </record>

</odoo>
