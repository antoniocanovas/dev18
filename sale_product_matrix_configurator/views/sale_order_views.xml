<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Add configurator mode to sale order form view -->
    <record id="view_order_form_configurator_mode" model="ir.ui.view">
        <field name="name">sale.order.form.configurator.mode</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_product_matrix.view_order_form_with_variant_grid"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_template_id']" position="before">
                <field name="display_type" column_invisible="1"/>
                <field name="configurator_mode_manual" column_invisible="True"/>
                <field name="configurator_mode" optional="show" 
                       decoration-muted="1"
                       invisible="display_type in ('line_section', 'line_note')"/>
            </xpath>
        </field>
    </record>

    <!-- Add configurator mode to order line tree view -->
    <record id="view_order_line_tree_configurator_mode" model="ir.ui.view">
        <field name="name">sale.order.line.tree.configurator.mode</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_subtotal']" position="after">
                <field name="display_type" column_invisible="1"/>
                <field name="configurator_mode" optional="hide" 
                       decoration-muted="1"
                       invisible="display_type in ('line_section', 'line_note')"/>
            </xpath>
        </field>
    </record>

</odoo>
