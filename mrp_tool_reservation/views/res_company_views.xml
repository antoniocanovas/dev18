<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mrp_tool_reservation_res_company_inh_form" model="ir.ui.view">
        <field name="name">mrp.tool.reservation.res.company.inh.form</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="MRP Tools">
                    <group>
                        <group>
                            <field name="mrp_tool_reservation_stage_id"/>
                            <field name="mrp_tool_done_stage_id"/>
                            <field name="mrp_tool_reservation_time" widget="float_time"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
