# ============================================
# Comentarios útiles
# ============================================

# Para incluir archivos específicos que normalmente serían ignorados:
# !importante.log

# Para ignorar todo un directorio excepto un archivo:
# directorio/*
# !directorio/archivo_importante.txt

# Para ignorar archivos con patrones específicos:
# *.extension
# prefix_*
# *_suffix.*