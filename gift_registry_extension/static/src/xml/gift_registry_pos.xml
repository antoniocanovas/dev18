<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Save as Gift Button Template -->
    <t t-name="point_of_sale.SaveAsGiftButton" owl="1">
        <div class="control-button" t-on-click="onClick" t-att-class="{ 'highlight': isVisible }">
            <i class="fa fa-gift"/>
            <span>Save as Gift</span>
        </div>
    </t>

    <!-- Load Gift Button Template -->
    <t t-name="point_of_sale.LoadGiftButton" owl="1">
        <div class="control-button" t-on-click="onClick">
            <i class="fa fa-cloud-download"/>
            <span>Load Gift</span>
        </div>
    </t>
    
    <!-- Top Bar Indicator -->
    <t t-name="GiftRegistryIndicator" t-inherit="point_of_sale.Chrome" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('pos-top-bar')]" position="inside">
            <div class="pos-top-bar-right-fragment">
                <t t-if="pos.is_gift_registry_active">
                    <div class="oe_status">
                        <span>Editing Gift Registry: </span>
                        <span class="oe_bold" t-esc="pos.gift_registry_name"/>
                    </div>
                </t>
            </div>
        </xpath>
    </t>

</templates>
