<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_product_pricelist_inh_form" model="ir.ui.view">
        <field name="name">shoes.product.pricelist.inh.form</field>
        <field name="model">product.pricelist</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Recalculation">
                    <group name="pricelist_recalculation" string="Product prices recalculation">
                        <field name="shoes_campaign_id" widget="selection"/>
                        <field name="recalculation_type"/>
                        <field name="marketing_discount"/>
                        <field name="margin" />
                        <field name="dollar_exchange" />
                    </group>
                    <group invisible="not shoes_campaign_id or not recalculation_type">
                        <button class="oe_highlight"
                                type="object"
                                name="campaign_pricelist_recalculation"
                                string="Recalculate"/>
                    </group>
                    <group name="product_template_in_pricelist">
                        <field name="product_tmpl_ids" groups="base.group_no_one"/>
                    </group>
                </page>
                <page string="Pairs" name="pairs_pricelist">
                    <field name="product_tmpl_item_ids">
                        <list>
                            <field name="product_tmpl_id"/>
                            <field name="price"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
