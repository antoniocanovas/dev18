<odoo>
    <!-- ===== FORM VIEW (inherit partner_risk_insurance) ===== -->
    <record id="view_partner_form_risk_insurance_end_date" model="ir.ui.view">
        <field name="name">res.partner.form.risk_insurance_end_date</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="partner_risk_insurance.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="risk_insurance_grant_date" position="after">
                <field name="risk_insurance_end_date"/>
            </field>
        </field>
    </record>

    <!-- ===== LIST VIEW ===== -->
    <record id="view_partner_risk_list" model="ir.ui.view">
        <field name="name">res.partner.risk.list</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <list
                string="Partner Risks"
                multi_edit="1"
                decoration-danger="risk_exception"
                decoration-warning="risk_amount_exceeded &gt; 0"
            >
                <field name="name" string="Partner" />
                <field
                    name="credit_limit"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                />
                <field
                    name="company_credit_limit"
                    optional="show"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                />
                <field
                    name="insurance_credit_limit"
                    optional="show"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                />
                <field
                    name="risk_remaining_value"
                    optional="show"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                    decoration-success="risk_remaining_value &gt; 0"
                    decoration-danger="risk_remaining_value &lt;= 0"
                />
                <field
                    name="risk_coverage_display"
                    optional="show"
                    decoration-success="risk_remaining_percentage &gt; 0"
                    decoration-danger="risk_remaining_percentage &lt; 0"
                />
                <field name="risk_remaining_percentage" optional="hide" />
                <field
                    name="risk_total"
                    optional="show"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                />
                <field name="risk_insurance_code" optional="hide" />
                <field name="risk_insurance_requested" optional="hide" />
                <field name="risk_insurance_grant_date" optional="hide" />
                <field
                    name="risk_insurance_end_date"
                    optional="hide"
                    decoration-danger="risk_insurance_expired"
                />
                <field name="credit_policy_state_id" optional="show" />
                <field name="credit_policy_company_id" optional="hide" />
                <field name="risk_insurance_coverage_percent" optional="hide" />
                <field
                    name="risk_amount_exceeded"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                />
                <field name="risk_exception" optional="hide" />
                <field
                    name="risk_sale_order"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                    decoration-danger="risk_sale_order_include and risk_sale_order &gt; risk_sale_order_limit"
                    decoration-success="risk_sale_order_include and risk_sale_order &gt; 0 and risk_sale_order &lt;= risk_sale_order_limit"
                />
                <field
                    name="risk_invoice_draft"
                    string="Invoice Draft Risk"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                    decoration-danger="risk_invoice_draft_include and risk_invoice_draft &gt; risk_invoice_draft_limit"
                    decoration-success="risk_invoice_draft_include and risk_invoice_draft &gt; 0 and risk_invoice_draft &lt;= risk_invoice_draft_limit"
                />
                <field
                    name="risk_invoice_open"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                    decoration-danger="risk_invoice_open_include and risk_invoice_open &gt; risk_invoice_open_limit"
                    decoration-success="risk_invoice_open_include and risk_invoice_open &gt; 0 and risk_invoice_open &lt;= risk_invoice_open_limit"
                />
                <field
                    name="risk_invoice_unpaid"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                    decoration-danger="risk_invoice_unpaid_include and risk_invoice_unpaid &gt; risk_invoice_unpaid_limit"
                    decoration-success="risk_invoice_unpaid_include and risk_invoice_unpaid &gt; 0 and risk_invoice_unpaid &lt;= risk_invoice_unpaid_limit"
                />
                <field
                    name="risk_account_amount"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                    decoration-danger="risk_account_amount_include and risk_account_amount &gt; risk_account_amount_limit"
                    decoration-success="risk_account_amount_include and risk_account_amount &gt; 0 and risk_account_amount &lt;= risk_account_amount_limit"
                />
                <field
                    name="risk_account_amount_unpaid"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                    decoration-danger="risk_account_amount_unpaid_include and risk_account_amount_unpaid &gt; risk_account_amount_unpaid_limit"
                    decoration-success="risk_account_amount_unpaid_include and risk_account_amount_unpaid &gt; 0 and risk_account_amount_unpaid &lt;= risk_account_amount_unpaid_limit"
                />
                <field
                    name="risk_payment_return"
                    optional="hide"
                    widget="monetary"
                    options="{'currency_field': 'risk_currency_id'}"
                    decoration-danger="risk_payment_return_include and risk_payment_return &gt; risk_payment_return_limit"
                    decoration-success="risk_payment_return_include and risk_payment_return &gt; 0 and risk_payment_return &lt;= risk_payment_return_limit"
                />
                <!-- Hidden fields needed for currency widget, decorations and filter domains -->
                <field name="risk_insurance_expired" column_invisible="1" />
                <field name="risk_currency_id" column_invisible="1" />
                <field name="risk_remaining_value_include" column_invisible="1" />
                <field name="risk_sale_order_include" column_invisible="1" />
                <field name="risk_invoice_draft_include" column_invisible="1" />
                <field name="risk_invoice_open_include" column_invisible="1" />
                <field name="risk_invoice_unpaid_include" column_invisible="1" />
                <field name="risk_account_amount_include" column_invisible="1" />
                <field name="risk_account_amount_unpaid_include" column_invisible="1" />
                <field name="risk_payment_return_include" column_invisible="1" />
                <field name="risk_sale_order_limit" column_invisible="1" />
                <field name="risk_invoice_draft_limit" column_invisible="1" />
                <field name="risk_invoice_open_limit" column_invisible="1" />
                <field name="risk_invoice_unpaid_limit" column_invisible="1" />
                <field name="risk_account_amount_limit" column_invisible="1" />
                <field name="risk_account_amount_unpaid_limit" column_invisible="1" />
                <field name="risk_payment_return_limit" column_invisible="1" />
            </list>
        </field>
    </record>

    <!-- ===== SEARCH VIEW ===== -->
    <record id="view_partner_risk_search" model="ir.ui.view">
        <field name="name">res.partner.risk.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search string="Partner Risks">
                <field name="name" string="Partner" />
                <field name="credit_policy_state_id" />
                <field name="credit_policy_company_id" />
                <separator />
                <filter
                    string="Include in Risk Monitoring"
                    name="filter_risk_remaining_value_include"
                    domain="[('risk_remaining_value_include', '=', True)]"
                />
                <separator />
                <filter
                    string="Sales Orders Risk"
                    name="filter_risk_sale_order"
                    domain="[('risk_sale_order_include', '=', True), ('risk_sale_order', '&gt;', 0)]"
                />
                <filter
                    string="Draft Invoice Risk"
                    name="filter_risk_invoice_draft"
                    domain="[('risk_invoice_draft_include', '=', True), ('risk_invoice_draft', '&gt;', 0)]"
                />
                <filter
                    string="Open Invoice Risk"
                    name="filter_risk_invoice_open"
                    domain="[('risk_invoice_open_include', '=', True), ('risk_invoice_open', '&gt;', 0)]"
                />
                <filter
                    string="Unpaid Invoice Risk"
                    name="filter_risk_invoice_unpaid"
                    domain="[('risk_invoice_unpaid_include', '=', True), ('risk_invoice_unpaid', '&gt;', 0)]"
                />
                <filter
                    string="Account Amount Risk"
                    name="filter_risk_account_amount"
                    domain="[('risk_account_amount_include', '=', True)]"
                />
                <filter
                    string="Account Unpaid Risk"
                    name="filter_risk_account_amount_unpaid"
                    domain="[('risk_account_amount_unpaid_include', '=', True)]"
                />
                <filter
                    string="Payment Return Risk"
                    name="filter_risk_payment_return"
                    domain="[('risk_payment_return_include', '=', True), ('risk_payment_return', '&gt;', 0)]"
                />
                <separator />
                <filter
                    string="Risk Exception"
                    name="filter_risk_exception"
                    domain="[('risk_exception', '=', True)]"
                />
                <filter
                    string="Amount Exceeded"
                    name="filter_risk_amount_exceeded"
                    domain="[('risk_amount_exceeded', '&gt;', 0)]"
                />
                <filter
                    string="Expired Insurance Contracts"
                    name="filter_risk_insurance_expired"
                    domain="[('risk_insurance_expired', '=', True)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Credit Policy Company"
                        name="group_credit_policy_company"
                        context="{'group_by': 'credit_policy_company_id'}"
                    />
                    <filter
                        string="Credit Policy State"
                        name="group_credit_policy_state"
                        context="{'group_by': 'credit_policy_state_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- ===== ACTION ===== -->
    <record id="action_partner_risk" model="ir.actions.act_window">
        <field name="name">Partner Risks</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_partner_risk_list')})]"
        />
        <field name="search_view_id" ref="view_partner_risk_search" />
        <field name="domain">[('is_company', '=', True), ('risk_remaining_value_include', '=', True)]</field>
        <field name="context">{}</field>
    </record>

    <!-- ===== MENU ===== -->
    <menuitem
        id="menu_partner_risk"
        name="Partner Risks"
        parent="account.menu_finance_receivables"
        action="action_partner_risk"
        groups="account_financial_risk.group_account_financial_risk_user"
        sequence="99"
    />
</odoo>
