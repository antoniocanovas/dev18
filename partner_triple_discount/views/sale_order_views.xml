<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Header-level triple discount defaults on the sale order (Other Info tab) -->
    <record id="sale_order_triple_discount_header_view" model="ir.ui.view">
        <field name="name">sale.order.triple.discount.header</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='other_information']//group[@name='sales_person']"
                position="after"
            >
                <group
                    name="triple_discount"
                    string="Default Discounts"
                    groups="sale.group_discount_per_so_line"
                >
                    <field name="discount1" />
                    <field name="discount2" />
                    <field name="discount3" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
