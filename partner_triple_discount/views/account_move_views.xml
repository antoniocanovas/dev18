<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_move_triple_discount_view" model="ir.ui.view">
        <field name="name">account.move.triple.discount</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <!-- Header discount defaults shown in the left group, only for customer invoices -->
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field
                    name="discount1"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                    readonly="state != 'draft'"
                />
                <field
                    name="discount2"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                    readonly="state != 'draft'"
                />
                <field
                    name="discount3"
                    invisible="move_type not in ('out_invoice', 'out_refund')"
                    readonly="state != 'draft'"
                />
            </xpath>
            <!-- Discount button below invoice lines (draft customer invoices only) -->
            <xpath
                expr="//page[@id='invoice_tab']/field[@name='invoice_line_ids']"
                position="after"
            >
                <div
                    class="float-end d-flex gap-1 mb-2"
                    name="invoice_triple_discount_button"
                    invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund')"
                >
                    <button
                        string="Discount"
                        name="action_open_triple_discount_wizard"
                        type="object"
                        class="btn btn-secondary"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
