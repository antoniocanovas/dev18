<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_view_triple_discount" model="ir.ui.view">
        <field name="name">res.partner.triple.discount</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Add triple discount defaults to the Sales group in Sales & Purchase tab -->
            <xpath
                expr="//page[@name='sales_purchases']//group[@name='sale']"
                position="inside"
            >
                <field
                    name="discount1"
                    groups="sales_team.group_sale_salesman,sale.group_discount_per_so_line"
                />
                <field
                    name="discount2"
                    groups="sales_team.group_sale_salesman,sale.group_discount_per_so_line"
                />
                <field
                    name="discount3"
                    groups="sales_team.group_sale_salesman,sale.group_discount_per_so_line"
                />
            </xpath>
        </field>
    </record>
</odoo>
