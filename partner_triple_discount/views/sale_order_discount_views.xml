<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Extend the standard Discount wizard to show disc2 and disc3
         when applying to all order lines -->
    <record id="sale_order_discount_triple_form_view" model="ir.ui.view">
        <field name="name">sale.order.discount.triple.form</field>
        <field name="model">sale.order.discount</field>
        <field name="inherit_id" ref="sale.sale_order_line_wizard_form"/>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='discount_percentage']"
                position="after"
            >
                <label
                    for="discount2"
                    string="Discount 2"
                    invisible="discount_type != 'sol_discount'"
                />
                <field
                    name="discount2"
                    invisible="discount_type != 'sol_discount'"
                    nolabel="1"
                />
                <label
                    for="discount3"
                    string="Discount 3"
                    invisible="discount_type != 'sol_discount'"
                />
                <field
                    name="discount3"
                    invisible="discount_type != 'sol_discount'"
                    nolabel="1"
                />
            </xpath>
        </field>
    </record>
</odoo>
