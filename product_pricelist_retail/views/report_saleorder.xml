<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <!-- Add RRP/PVP column header -->
        <xpath expr="//thead/tr/th[@name='th_priceunit']" position="after">
            <th name="th_retail_price" class="text-end">
                <span>RRP</span>
            </th>
        </xpath>
        
        <!-- Add RRP/PVP column data -->
        <xpath expr="//tbody[@class='sale_tbody']//td[@name='td_priceunit']" position="after">
            <td name="td_retail_price" class="text-end">
                <span t-if="line.retail_price" t-field="line.retail_price"/>
            </td>
        </xpath>
    </template>
</odoo>
