<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- VISTA SOLO PT: -->
    <record id="intrastat_duty_pt_only_inh_form" model="ir.ui.view">
        <field name="name">intrastat.duty.pt.only.inh.form</field>
        <field name="model">product.template</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- Campo para estimación de costes intrastat: -->
            <xpath expr="//field[@name='property_account_expense_id']" position="after">
                <field name="intrastat_duty_id"/>
            </xpath>
            <!-- Estimación de coste con aduanas: -->
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <field name="estimated_landed_cost" widget="monetary"
                       string="Landed cost inc."
                       invisible="not intrastat_duty_id or product_variant_ids >1"
                       help="Standard + duty estimation cost"
                />
            </xpath>
        </field>
    </record>

    <!-- VISTA PARA VARIANTES (product.product): -->
    <record id="intrastat_duty_product_variant_inh_form" model="ir.ui.view">
        <field name="name">intrastat.duty.product.variant.inh.form</field>
        <field name="model">product.product</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- Estimación de coste con aduanas: -->
            <xpath expr="//div[@name='standard_price_uom']" position="after">
                <field name="estimated_landed_cost" widget="monetary"
                       string="Landed cost inc."
                       invisible="not intrastat_duty_id"
                       help="Standard + duty estimation cost"
                />
            </xpath>
        </field>
    </record>

</odoo>