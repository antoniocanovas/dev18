<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ACCION DE VENTANA: -->
    <record id="action_fsc_audit" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="filter" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="limit">80</field>
        <field name="name">FSC Auditories</field>
        <field name="res_model">fsc.audit</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- CONFIG MENU: -->
    <record id="fsc_audit_menu" model="ir.ui.menu">
        <field name="action" ref="action_fsc_audit"/>
        <field name="active" eval="True"/>
        <field name="name">FSC Auditories</field>
        <field name="parent_id" ref="stock.menu_warehouse_report"/>
        <field name="sequence">200</field>
        <field name="web_icon" eval="False"/>
    </record>


    <!-- FORM VIEW: -->
    <record id="fsc_audit_default_form" model="ir.ui.view">
        <field name="name">fsc.audit.default.form</field>
        <field name="model">fsc.audit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                    <button name="compute_fsc_audit"
                            icon="fa-delicious" class="oe_stat_button"
                            type="object" string="Compute">
                    </button>
                </header>
                <sheet>
                    <h1>
                        <field name="name" required="1" placeholder="e.g. Audit #..." />
                    </h1>
                    <group>
                        <group>
                            <field name="date_from" required="1"/>
                            <field name="date_to" required="1"/>
                        </group>
                        <group>
                            <field name="auditor_id"/>
                            <field name="audit_date"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="raw_product_id"/>
                            <field name="raw_product_qty"/>
                            <field name="raw_fsc_format_id"/>
                            <field name="raw_scientific_name"/>
                            <field name="raw_consumed"/>
                            <field name="raw_stock"/>
                            <field name="final_fsc_format_id"/>
                            <field name="final_sold_qty"/>
                            <field name="final_no_tracking"/>
                            <field name="final_efficiency"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Details">
                            <field name="notes" placeholder="Audit details and notes..."/>
                        </page>
                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">form</field>
    </record>

    <!-- list VIEW: -->
    <record id="fsc_audit_default_list" model="ir.ui.view">
        <field name="name">fsc.audit.default.list</field>
        <field name="model">fsc.audit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </list>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">list</field>
    </record>

</odoo>
