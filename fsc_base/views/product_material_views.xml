<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="fsc_base_product_material_form_inh" model="ir.ui.view">
        <field name="name">fsc.product.material.form.inh</field>
        <field name="model">product.material</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product_material.product_material_default_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='comment']" position="before">
                <field name="fsc_tracking"/>
                <field name="fsc_mix_estimation" invisible="not fsc_tracking"/>
                <field name="fsc_mix_percentage"
                       invisible="not fsc_tracking or not fsc_mix_estimation"
                       required="fsc_mix_estimation"
                />
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>

    <record id="fsc_product_material_inh_list" model="ir.ui.view">
        <field name="name">fsc.product.material.inh.list</field>
        <field name="model">product.material</field>
        <field name="type">list</field>
        <field name="inherit_id" ref="product_material.product_material_default_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="fsc_tracking"/>
                <field name="fsc_mix_estimation" invisible="not fsc_tracking"/>
                <field name="fsc_mix_percentage" invisible="not fsc_tracking or not fsc_mix_estimation"/>
            </xpath>
        </field>
        <field name="priority">16</field>
    </record>

</odoo>
