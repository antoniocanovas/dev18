<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="fsc_stock_lot_form_inh" model="ir.ui.view">
        <field name="name">fsc.stock.lot.form.inh</field>
        <field name="model">stock.lot</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='main_group']" position="after">
                <group name="wood_tracking" string="Wood tracking" invisible="not wood_tracking">
                    <group>
                        <field name="material_id"/>
                        <field name="wood_tracking"/>
                        <field name="is_fsc" invisible="not wood_tracking"/>
                        <field name="is_cites" invisible="not wood_tracking"/>
                        <field name="fsc_efficiency"/>
                    </group>
                    <group>
                        <field name="fsc_lot_type"/>
                        <field name="fsc_percentage"/>
                        <field name="raw_efficiency"/>
                        <field name="initial_received_quantity_computed"/>
                        <field name="descendant_lot_ids" widget="many2many_tags"/>
                    </group>
                </group>
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>

</odoo>

