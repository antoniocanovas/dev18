<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <template id="report_purchaseorder_inh_navima" inherit_id="purchase.report_purchaseorder_document" priority="999">
        <xpath expr="//span[@t-field='line.product_qty']" position="replace">
            <span t-out="int(line.product_qty) if line.product_qty == int(line.product_qty) else line.product_qty"
                  class="text-nowrap"/>
        </xpath>
        <!-- Añadir columna "Precio par" después de Quantity en thead -->
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_num_pares" class="text-end text-nowrap"><strong>Precio</strong></th>
        </xpath>
        <!-- Heredar th de precio unitario y cambiar texto a "Precio caja" -->
        <xpath expr="//th[@name='th_price_unit']/strong" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <xpath expr="//th[@name='th_price_unit']/strong" position="after">
            <strong>Precio caja</strong>
        </xpath>

        <!-- Añadir columna "Num pares" después de Quantity en tbody -->
        <!--        <xpath expr="//td[2]" position="after">-->
        <!--            <td t-if="line.display_type == 'product' and line.pairs_count > 0" name="td_num_pares" class="text-end text-nowrap">-->
        <!--                <t t-if="line.pairs_count > 0">-->
        <!--                    <span t-esc="line.price_unit / line.pairs_count">0</span>-->
        <!--                </t>-->
        <!--            </td>-->
        <!--            <td t-if="line.display_type == 'product' and line.pairs_count == 0" name="td_num_pares" class="text-end text-nowrap">-->
        <!--                <span t-esc="line.price_unit "></span>-->
        <!--            </td>-->
        <!--        </xpath>-->
        <xpath expr="//td[2]" position="after">
            <td t-if="line.product_template_id.is_assortment"
                name="td_num_pares" class="text-end text-nowrap">
                <span t-esc="line.price_unit / line.pairs_count"
                      t-options="{'widget': 'float', 'precision': 2}">0</span>
            </td>
            <td t-if="not line.product_template_id.is_assortment"
                name="td_num_pares" class="text-end text-nowrap">
                <span t-esc="line.price_unit"
                      t-options="{'widget': 'float', 'precision': 2}"/>
            </td>
        </xpath>


        <!-- Ocultar la unidad de medida en la columna de cantidad -->
        <xpath expr="//td[2]/span[@t-field='line.product_uom.name']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>
           <xpath expr="//td[2]/span[@t-if='line.product_packaging_id']" position="attributes">
            <attribute name="class">d-none</attribute>
        </xpath>



    </template>
</odoo>
