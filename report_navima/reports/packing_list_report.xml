<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Paperformat for landscape orientation -->
    <record id="paperformat_packing_list" model="report.paperformat">
        <field name="name">Packing List - Landscape</field>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">25</field>
        <field name="dpi">90</field>
    </record>

    <!-- Report Definition -->
    <record id="action_report_packing_list" model="ir.actions.report">
        <field name="name">Packing List</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">report_navima.report_packing_list_document</field>
        <field name="report_file">report_navima.report_packing_list_document</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_packing_list"/>
    </record>

    <!-- Custom external layout for packing list -->
    <template id="external_layout_packing_list">
        <div class="header">
            <table class="table-borderless" style="width: 100%; table-layout: fixed; border: none;">
                <tr>
                    <!-- Left: Company name -->
                    <td style="width: 33.33%; text-align: left; vertical-align: middle; border: none;">
                        <h4 style="margin: 0; font-weight: bold;">NAVIMA CALZADOS, S.L</h4>
                    </td>

                    <!-- Center: Packing List title -->
                    <td style="width: 33.33%; text-align: center; vertical-align: middle; border: none;">
                        <h2 style="font-weight: bold; margin: 0;">PACKING LIST</h2>
                    </td>

                    <!-- Right: Page number -->
                    <td style="width: 33.33%; text-align: right; vertical-align: middle; border: none;">
                        <div style="font-size: 12px;">
                            Page <span class="page"/> of <span class="topage"/>
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <div class="article o_report_layout_standard">
            <t t-raw="0"/>
        </div>

        <div class="footer">
            <div style="text-align: center; font-size: 10px; border-top: 1px solid #ccc; padding-top: 5px;">
                <span class="page"/> / <span class="topage"/>
            </div>
        </div>
    </template>

    <!-- Report Template -->
    <template id="report_packing_list_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="report_navima.external_layout_packing_list">
                    <div class="page">
                        <div class="oe_structure"/>

                        <!-- Lots Table with dynamic size columns -->
                        <t t-set="size_data" t-value="o.get_packing_list_size_data()"/>
                        <table class="table table-sm table-borderless" style="font-size: 11px; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th class="text-center" style="width: 10%; border-bottom: 1px solid #000;">Box</th>
                                    <th class="text-center" style="width: 10%; border-bottom: 1px solid #000;">Order</th>
                                    <th class="text-center" style="width: 8%; border-bottom: 1px solid #000;">NRB</th>
                                    <th class="text-center" style="width: 12%; border-bottom: 1px solid #000;">Item</th>
                                    <th class="text-center" style="width: 10%; border-bottom: 1px solid #000;">Color</th>
                                    <!-- Dynamic size columns -->
                                    <t t-foreach="size_data['all_sizes']" t-as="size">
                                        <th class="text-center" style="border-bottom: 1px solid #000; min-width: 30px;">
                                            <span t-esc="size"/>
                                        </th>
                                    </t>
                                    <!-- Boxes column -->
                                    <th class="text-center" style="border-bottom: 1px solid #000; min-width: 40px;">Boxes</th>
                                    <!-- Quantity column -->
                                    <th class="text-center" style="border-bottom: 1px solid #000; min-width: 40px;">Quantity</th>
                                    <!-- Brand column -->
                                    <th class="text-center" style="border-bottom: 1px solid #000; min-width: 50px;">Brand</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Iterate through lot data -->
                                <t t-foreach="size_data['lot_data']" t-as="lot_info">
                                    <tr>
                                        <td class="text-center">
                                            <span t-esc="lot_info['lot_name']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="lot_info['order']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="lot_info['nrb']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="lot_info['item']"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-esc="lot_info['color']"/>
                                        </td>
                                        <!-- Dynamic size quantity columns -->
                                        <t t-foreach="size_data['all_sizes']" t-as="size">
                                            <td class="text-center" style="min-width: 30px;">
                                                <span t-esc="lot_info['sizes'].get(size, '')"/>
                                            </td>
                                        </t>
                                        <!-- Boxes column -->
                                        <td class="text-center" style="min-width: 40px;">
                                            <span t-esc="lot_info['total_pairs']"/>
                                        </td>
                                        <!-- Quantity column -->
                                        <td class="text-center" style="min-width: 40px;">
                                            <span t-esc="lot_info['quantity']"/>
                                        </td>
                                        <!-- Brand column -->
                                        <td class="text-center" style="min-width: 50px;">
                                            <span t-esc="lot_info['brand']"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- If no lots, show message -->
                                <t t-if="not size_data['lot_data']">
                                    <tr>
                                        <td t-att-colspan="8 + len(size_data['all_sizes'])" class="text-center text-muted">
                                            No lots assigned to this delivery
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
