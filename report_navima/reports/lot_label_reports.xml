<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Custom paper format for 1x1 A4 labels -->
        <record id="paperformat_lot_label_1x1_a4" model="report.paperformat">
            <field name="name">Lot Label 1x1 A4</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_spacing">0</field>
            <field name="dpi">90</field>
        </record>

        <!-- 1x1 A4 Format Report Action -->
        <record id="action_report_lot_label_1x1_a4" model="ir.actions.report">
            <field name="name">Lot Labels 1x1 A4 (PDF)</field>
            <field name="model">stock.lot</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">report_navima.report_lot_label_1x1_a4</field>
            <field name="report_file">report_navima.report_lot_label_1x1_a4</field>
            <field name="paperformat_id" ref="paperformat_lot_label_1x1_a4"/>
            <field name="print_report_name">'Lot Labels 1x1 A4 - %s' % object.name</field>
        </record>
    </data>
</odoo>
