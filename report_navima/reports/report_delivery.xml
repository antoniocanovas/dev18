<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Add Sizes column header and weight/volume totals in the delivery document table -->
    <template id="report_delivery_document_inh_navima" inherit_id="stock.report_delivery_document" priority="999">
        <!-- Shipping Mark en cabecera del albarán de salida -->
        <xpath expr="//div[@id='informations']" position="before">
            <div t-if="(o.partner_id.commercial_partner_id.sale_type or o.partner_id.commercial_partner_id.shoes_shippingmark_ids) and o.shippingmark_id"
                 class="row mb-2" name="shippingmark_section">
                <div class="col-12">
                    <span style="font-weight: 600; margin-right: 6px;">Shipping Mark:</span>
                    <span class="text-white"
                          style="background-color: #41a9a2;
                                 border: 1px solid #41a9a2;
                                 padding: 4px 12px;
                                 margin: 2px 4px 2px 0;
                                 border-radius: 15px;
                                 font-size: 11px;
                                 font-weight: 500;
                                 display: inline-block;
                                 line-height: 1.2;">
                        <t t-out="o.shippingmark_id.name"/>
                    </span>
                </div>
            </div>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_product']" position="after">
            <th name="th_sizes" class="text-center">
                <strong>Sizes</strong>
            </th>
        </xpath>
        <xpath expr="//div[@name='div_origin']" position="replace">
            <div t-if="o.origin" class="col col-2 mw-100 mb-2" name="div_origin">
                <strong>Pedido</strong>
                <div t-field="o.origin" class="m-0"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='div_sched_date']" position="replace">
            <div t-if="o.state" class="col col-2 mw-100 mb-2" name="div_sched_date">
                <strong>Fecha de envío</strong>
                <div t-if="o.state == 'done'" t-field="o.date_done" class="m-0" t-options='{"widget": "date"}'/>
                <div t-else="" t-field="o.scheduled_date" class="m-0" t-options='{"widget": "date"}'/>
            </div>
        </xpath>
    </template>

    <template id="report_delivery_volume_inh_navima" inherit_id="stock_delivery.report_delivery_document2" priority="999">
        <xpath expr="//div[contains(@t-if, 'carrier_id')]" position="attributes">
            <attribute name="class">col col-2 mw-100 mb-2</attribute>
        </xpath>
        <xpath expr="//div[@t-if='o.shipping_weight']" position="attributes">
            <attribute name="class">col col-2 mw-100 mb-2</attribute>
        </xpath>
        <xpath expr="//div[@t-if='o.shipping_weight']" position="after">
            <div t-if="o.shipping_volume" class="col col-2 mw-100 mb-2">
                <strong>Volumen</strong>
                <div>
                    <span t-field="o.shipping_volume"/> m³
                </div>
            </div>
        </xpath>
        <xpath expr="//div[@t-if='o.carrier_tracking_ref']" position="attributes">
            <attribute name="class">col col-2 mw-100 mb-2</attribute>
        </xpath>
    </template>

    <!-- Add Sizes column content in has_serial move line template -->
    <template id="stock_report_delivery_has_serial_move_line_inh_navima" inherit_id="stock.stock_report_delivery_has_serial_move_line" priority="999">
        <xpath expr="//td[1]" position="after">
            <td name="td_sizes" class="text-center" style="font-size: 10px;">
                <t t-if="move_line.lot_id and move_line.lot_id.assortment_pair">
                    <table class="table table-bordered table-sm" style="margin: 0 auto; max-width: 250px; font-size: 9px;">
                        <thead class="table-light text-center">
                            <tr>
                                <!-- Header with sizes -->
                                <t t-set="lot_assortment" t-value="move_line.lot_id.assortment_pair.split(';')"/>
                                <t t-if="len(lot_assortment) >= 1">
                                    <t t-set="tallas" t-value="lot_assortment[0].split(',')"/>
                                    <t t-foreach="tallas" t-as="talla">
                                        <th t-esc="talla.strip()" class="border text-center" style="padding: 1px 3px;"/>
                                    </t>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="text-center">
                                <!-- Row with quantities -->
                                <t t-if="len(lot_assortment) >= 2">
                                    <t t-set="cantidades" t-value="[c for c in lot_assortment[1].split(',') if c.strip()]"/>
                                    <t t-foreach="cantidades" t-as="cantidad">
                                        <td t-esc="cantidad.strip()" class="border text-center" style="padding: 1px 3px;"/>
                                    </t>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <t t-else="">
                    <small class="text-muted">-</small>
                </t>
            </td>
        </xpath>
    </template>

    <!-- Add Sizes column content in aggregated move lines template -->
    <template id="stock_report_delivery_aggregated_move_lines_inh_navima" inherit_id="stock.stock_report_delivery_aggregated_move_lines" priority="999">
        <xpath expr="//td[1]" position="after">
            <td name="td_sizes" class="text-center" style="font-size: 10px;">
                <t t-if="'move' in aggregated_lines[line] and aggregated_lines[line]['move']">
                    <t t-set="move_obj" t-value="aggregated_lines[line]['move']"/>
                    <t t-set="lots_with_sizes" t-value="move_obj.move_line_ids.filtered(lambda ml: ml.lot_id and ml.lot_id.assortment_pair)"/>

                    <t t-if="lots_with_sizes">
                        <!-- Group by assortment_pair pattern instead of lot -->
                        <t t-set="pattern_dict" t-value="{}"/>
                        <t t-foreach="lots_with_sizes" t-as="ml">
                            <t t-set="pattern_key" t-value="ml.lot_id.assortment_pair"/>
                            <t t-if="pattern_key not in pattern_dict">
                                <t t-set="pattern_dict" t-value="pattern_dict.update({pattern_key: {'count': 1, 'quantity': ml.quantity}}) or pattern_dict"/>
                            </t>
                            <t t-else="">
                                <t t-set="current_data" t-value="pattern_dict[pattern_key]"/>
                                <t t-set="pattern_dict" t-value="pattern_dict.update({pattern_key: {'count': current_data['count'] + 1, 'quantity': current_data['quantity'] + ml.quantity}}) or pattern_dict"/>
                            </t>
                        </t>

                        <!-- Display one table per unique pattern with multiplied quantities -->
                        <t t-foreach="pattern_dict.items()" t-as="pattern_item">
                            <t t-set="assortment_pair" t-value="pattern_item[0]"/>
                            <t t-set="pattern_data" t-value="pattern_item[1]"/>

                            <div t-if="pattern_item_index > 0" style="border-top: 1px dashed #999; margin: 3px 0;"/>
                            <table class="table table-bordered table-sm" style="margin: 0 auto; max-width: 250px; font-size: 9px;">
                                <thead class="table-light text-center">
                                    <tr>
                                        <t t-set="lot_assortment" t-value="assortment_pair.split(';')"/>
                                        <t t-if="len(lot_assortment) >= 1">
                                            <t t-set="tallas" t-value="lot_assortment[0].split(',')"/>
                                            <t t-foreach="tallas" t-as="talla">
                                                <th t-esc="talla.strip()" class="border text-center" style="padding: 1px 3px;"/>
                                            </t>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="text-center">
                                        <t t-if="len(lot_assortment) >= 2">
                                            <t t-set="cantidades" t-value="[c for c in lot_assortment[1].split(',') if c.strip()]"/>
                                            <!-- Multiply quantities by the total quantity -->
                                            <t t-set="multiplier" t-value="int(pattern_data['quantity'])"/>
                                            <t t-foreach="cantidades" t-as="cantidad">
                                                <t t-set="qty_value" t-value="int(cantidad.strip()) * multiplier"/>
                                                <td t-esc="qty_value" class="border text-center" style="padding: 1px 3px;"/>
                                            </t>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                    </t>
                    <t t-else="">
                        <small class="text-muted">-</small>
                    </t>
                </t>
                <t t-else="">
                    <small class="text-muted">-</small>
                </t>
            </td>
        </xpath>
    </template>

</odoo>
