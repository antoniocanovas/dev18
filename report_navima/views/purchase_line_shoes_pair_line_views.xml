<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_purchase_line_shoes_pair_line_tree" model="ir.ui.view">
        <field name="name">purchase.line.shoes.pair.line.tree</field>
        <field name="model">purchase.line.shoes.pair.line</field>
        <field name="arch" type="xml">
            <list>
                <header>
                    <button name="action_print_size_matrix_report"
                            type="object"
                            string="Imprimir Matriz de Surtidos"
                            class="btn-primary"/>
                </header>
                <field name="product_image" string="Imagen" widget="image" optional="hide"/>
                <field name="order_id" readonly="1" optional="hide"/>
                <field name="purchase_line_id" readonly="1" optional="hide"/>
                <field name="shoes_model_material" optional="hide"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="manufacturer_id" optional="hide"/>
                <field name="material_id" optional="hide"/>
                <field name="shoes_last_id" optional="hide"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="shoes_campaign_id" optional="hide"/>
                <field name="product_assortment_id" optional="hide"/>
                <field name="color_value_id" optional="hide"/>
                <field name="size_value_id" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_purchase_line_shoes_pair_line_pivot" model="ir.ui.view">
        <field name="name">purchase.line.shoes.pair.line.pivot</field>
        <field name="model">purchase.line.shoes.pair.line</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Pares">
                <field name="order_id" type="row"/>
                <field name="product_assortment_id" type="row"/>
                <field name="color_value_id" type="row"/>
                <field name="size_value_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_purchase_line_shoes_pair_line_graph" model="ir.ui.view">
        <field name="name">purchase.line.shoes.pair.line.graph</field>
        <field name="model">purchase.line.shoes.pair.line</field>
        <field name="arch" type="xml">
            <graph string="Gráfico de Pares" type="bar">
                <field name="size_value_id"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_purchase_line_shoes_pair_line_form" model="ir.ui.view">
        <field name="name">purchase.line.shoes.pair.line.form</field>
        <field name="model">purchase.line.shoes.pair.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="purchase_line_id"/>
                            <field name="sale_order_id"/>
                            <field name="partner_id"/>
                            <field name="shoes_campaign_id"/>
                            <field name="product_id"/>
                            <field name="quantity"/>
                        </group>
                        <group>
                            <field name="manufacturer_id"/>
                            <field name="material_id"/>
                            <field name="shoes_last_id"/>
                            <field name="product_assortment_id"/>
                            <field name="shoes_model_material"/>
                            <field name="color_value_id"/>
                            <field name="size_value_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_purchase_line_shoes_pair_line_search" model="ir.ui.view">
        <field name="name">purchase.line.shoes.pair.line.search</field>
        <field name="model">purchase.line.shoes.pair.line</field>
        <field name="arch" type="xml">
            <search>
                <!-- Search fields -->
                <field name="order_id"/>
                <field name="purchase_line_id"/>
                <field name="product_id"/>
                <field name="manufacturer_id"/>
                <field name="material_id"/>
                <field name="shoes_last_id"/>
                <field name="sale_order_id"/>
                <field name="partner_id"/>
                <field name="shoes_campaign_id"/>
                <field name="product_assortment_id"/>
                <field name="shoes_model_material"/>
                <field name="color_value_id"/>
                <field name="size_value_id"/>

                <!-- Filters -->
                <filter string="With Quantity" name="filter_with_quantity"
                        domain="[('quantity', '>', 0)]"/>
                <separator/>

                <!-- Group By -->
                <group expand="1" string="Group By">
                    <filter string="Purchase Order" name="group_by_purchase_order"
                            context="{'group_by':'order_id'}"/>
                    <filter string="Purchase Order Line" name="group_by_purchase_order_line"
                            context="{'group_by':'purchase_line_id'}"/>
                    <filter string="Sale Order" name="group_by_sale_order"
                            context="{'group_by':'sale_order_id'}"/>
                    <filter string="Customer" name="group_by_customer"
                            context="{'group_by':'partner_id'}"/>
                    <filter string="Campaign" name="group_by_campaign"
                            context="{'group_by':'shoes_campaign_id'}"/>
                    <filter string="Manufacturer" name="group_by_manufacturer"
                            context="{'group_by':'manufacturer_id'}"/>
                    <filter string="Material" name="group_by_material"
                            context="{'group_by':'material_id'}"/>
                    <filter string="Last" name="group_by_last"
                            context="{'group_by':'shoes_last_id'}"/>
                    <filter string="Model" name="group_by_model"
                            context="{'group_by':'shoes_model_material'}"/>
                    <filter string="Assortment" name="group_by_assortment"
                            context="{'group_by':'product_assortment_id'}"/>
                    <filter string="Product" name="group_by_product"
                            context="{'group_by':'product_id'}"/>
                    <filter string="Color" name="group_by_color"
                            context="{'group_by':'color_value_id'}"/>
                    <filter string="Size" name="group_by_size"
                            context="{'group_by':'size_value_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_purchase_line_shoes_pair_line" model="ir.actions.act_window">
        <field name="name">Purchase Shoes Pair Lines</field>
        <field name="res_model">purchase.line.shoes.pair.line</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="context">{'search_default_group_by_purchase_order': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No purchase shoes pair lines found
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_purchase_line_shoes_pair_line"
              name="Purchase Shoes Pair Lines"
              parent="purchase.menu_purchase_config"
              action="action_purchase_line_shoes_pair_line"
              sequence="100"/>

    <!-- Action for Reports Menu -->
    <record id="action_purchase_line_shoes_pair_line_report" model="ir.actions.act_window">
        <field name="name">Shoes Pair Lines Report</field>
        <field name="res_model">purchase.line.shoes.pair.line</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="context">{'search_default_group_by_campaign': 1, 'search_default_group_by_model': 1, 'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No purchase shoes pair lines found
            </p>
        </field>
    </record>

    <!-- Menu Item under Reports -->
    <menuitem id="menu_purchase_line_shoes_pair_line_report"
              name="Shoes Purchases"
              parent="purchase.purchase_report_main"
              action="action_purchase_line_shoes_pair_line_report"
              sequence="20"/>


    <menuitem id="menu_analysis_purchase_line_shoes_pair_line_report"
              name="Shoes Purchases"
              parent="shoes_analysis.menu_shoes_analysis_proveedores"
              action="action_purchase_line_shoes_pair_line_report"
              sequence="100"/>

</odoo>
