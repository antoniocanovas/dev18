<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_view_shoes_pair_lines" model="ir.ui.view">
        <field name="name">purchase.order.form.shoes.pair.lines</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Añadir el botón después del botón de imprimir etiquetas -->
            <xpath expr="//button[@name='action_view_associated_lots']" position="after">
                <button type="object"
                        name="action_view_shoes_pair_lines"
                        class="oe_stat_button"
                        icon="fa-list-ul"
                        invisible="shoes_pair_line_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="shoes_pair_line_count"/>
                        </span>
                        <span class="o_stat_text">shoes Pair</span>
                    </div>
                </button>
                <button type="object"
                        name="action_download_carton_detail_xlsx"
                        class="oe_stat_button"
                        icon="fa-file-excel-o"
                        invisible="shoes_pair_line_count == 0"
                        string="Carton Detail"/>
            </xpath>
        </field>
    </record>
</odoo>
