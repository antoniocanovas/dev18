<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Añadir botón de exportación a la vista de formulario de shoes.analysis -->
    <record id="shoes_analysis_form_view_inherit_export" model="ir.ui.view">
        <field name="name">shoes.analysis.form.inherit.export</field>
        <field name="model">shoes.analysis</field>
        <field name="inherit_id" ref="shoes_analysis.view_shoes_analysis_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_export_to_spreadsheet"
                        type="object"
                        string="Exportar"
                        class="oe_stat_button"
                        icon="fa-file-excel-o"
                        invisible="not data"/>
            </xpath>
        </field>
    </record>
</odoo>
