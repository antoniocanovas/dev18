<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de Búsqueda para el Modelo de Exportación -->
    <record id="shoes_analysis_export_search_view" model="ir.ui.view">
        <field name="name">shoes.analysis.export.search</field>
        <field name="model">shoes.analysis.export</field>
        <field name="arch" type="xml">
            <search>
                <field name="campaign_id"/>
                <field name="last_id"/>
                <field name="referrer_id"/>
                <field name="country_id"/>
                <field name="sale_type_id" string="Shipping Mark"/>
            </search>
        </field>
    </record>

    <!-- Vista de Lista para las líneas de exportación de Ventas por Agente -->
    <record id="shoes_analysis_export_salesman_delivery_list_view" model="ir.ui.view">
        <field name="name">shoes.analysis.export.salesman_delivery.list</field>
        <field name="model">shoes.analysis.export</field>
        <field name="arch" type="xml">
            <list delete="false">
                <field name="campaign_id"/>
                <field name="referrer_id"/>
                <field name="net_pairs" sum="false"/>
                <field name="net_sales" sum="false"/>
                <field name="total_pairs" sum="false"/>
                <field name="cancelled_pairs" sum="false"/>
            </list>
        </field>
    </record>

    <!-- Vista de Lista para las líneas de exportación de Ventas por Representante y País -->
    <record id="shoes_analysis_export_salesman_country_list_view" model="ir.ui.view">
        <field name="name">shoes.analysis.export.salesman_country.list</field>
        <field name="model">shoes.analysis.export</field>
        <field name="arch" type="xml">
            <list delete="false">
                <field name="campaign_id"/>
                <field name="referrer_id"/>
                <field name="country_id"/>
                <field name="net_pairs" sum="false"/>
                <field name="net_sales" sum="false"/>
                <field name="total_pairs" sum="false"/>
                <field name="cancelled_pairs" sum="false"/>
            </list>
        </field>
    </record>

