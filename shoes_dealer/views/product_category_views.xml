<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_dealer_product_category_inh_form" model="ir.ui.view">
        <field name="name">shoes.dealer.product.category.inh.form</field>
        <field name="model">product.category</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='first']" position="after">
                <group>
                    <group name="shoes_dealer" string="SHOES DEALER">
                        <field name="shoes_assortmentpairs_qty"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="shoes_dealer_product_category_inh_list" model="ir.ui.view">
        <field name="name">shoes.dealer.product.category.inh.list</field>
        <field name="model">product.category</field>
        <field name="type">list</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="shoes_assortmentpairs_qty" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
