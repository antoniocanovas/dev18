<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_dealer_inh_form" model="ir.ui.view">
        <field name="name">shoes.dealer.inh.form</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="after">
                <page string="Shoes dealer" name="shoes_dealer">
                    <group>
                        <group>
                            <field name="is_shoes_company"/>
                        </group>
                    </group>

                    <group invisible="not is_shoes_company">
                        <group name="shoes_attributes" string="Attributes">
                            <field name="assortment_attribute_id" domain="[('create_variant','!=','no_variant')]"
                                   required="is_shoes_company"/>
                            <field name="size_attribute_id" domain="[('create_variant','!=','no_variant')]"
                                   required="is_shoes_company"/>
                            <field name="color_attribute_id" domain="[('create_variant','!=','no_variant')]"
                                   required="is_shoes_company"/>
                            <field name="assortment_prefix"/>
                            <field name="single_prefix"/>
                            <field name="shoes_pair_uom_id"
                                   required="is_shoes_company"/>
                        </group>
                        <group name="shoes_commercial" string="Sale and purchases">
                            <field name="single_sale"/>
                            <field name="shoes_pair_weight_std"/>
                            <field name="shoes_hs_code_std"/>
                            <field name="single_purchase"/>
                            <field name="exwork_currency_id"/>
                        </group>
                        <group name="lot_name" string="LOT NAME">
                            <field name="lot_name_campaign"/>
                            <field name="lot_name_manufacturer"/>
                            <field name="lot_name_brand"/>
                        </group>
                        <group name="shoes_tracking" string="Tracking" invisible="not is_shoes_company">
                            <field name="shoes_assortment_tracking" required="is_shoes_company"/>
                            <field name="shoes_pair_tracking" required="is_shoes_company"/>
                        </group>
                        <group name="shoes_sync_options" string="Sync options" invisible="not is_shoes_company">
                            <field name="shoes_categ_sync"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
