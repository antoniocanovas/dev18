<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1) PRIMERO: la acción para Campaigns -->
    <record id="shoes_dealer_open_shoes_dealer_campaigns" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">project.project</field>
        <field name="view_mode">kanban,list,form,calendar,activity</field>
        <field name="view_id" ref="project.view_project_kanban"/>
        <field name="view_id" ref="project.view_project_kanban"/>
        <field name="search_view_id" ref="project.view_project_project_filter"/>
        <field name="target">main</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No shoe campaigns found. Create one!
            </p>
            <p>
                Here you will only see projects marked as shoe campaigns.
            </p>
        </field>
    </record>

    <record id="shoes_dealer_product_template_action_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="domain">['|', '|',
            ('is_assortment', '=', True),
            ('is_pair', '=', True),
            ('shoes_task_id', '!=', False)
            ]
        </field>
        <field name="context">{"search_default_goods": 1, 'default_is_storable': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No product found. Let's create one!
            </p>
            <p>
                Track your stock quantities by creating storable products.
            </p>
        </field>
    </record>

    <record id="shoes_dealer_stock_product_normal_action" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">['|', '|',
            ('is_assortment', '=', True),
            ('is_pair', '=', True),
            ('shoes_task_id', '!=', False)
            ]
        </field>
        <field name="search_view_id" ref="stock.stock_product_search_form_view"/>
    </record>


    <!-- 2) Luego el menú, que ya podrá resolver la acción -->
    <menuitem
            name="Shoes Dealer"
            id="shoes_dealer_main_menu"
            sequence="55"
            web_icon="shoes_dealer,static/description/icon.png"
    >
        <!-- Design -->
        <menuitem
                name="Design"
                id="shoes_dealer_design_menu"
                sequence="10"
                groups="project.group_project_user"
        >
            <menuitem
                    name="Campaigns"
                    id="shoes_dealer_campaigns"
                    sequence="10"
                    action="shoes_dealer.shoes_dealer_open_shoes_dealer_campaigns"
                    groups="project.group_project_user"
            />
        </menuitem>

        <!-- Products -->
        <menuitem
                name="Products"
                id="shoes_dealer_products_menu"
                sequence="20"
                groups="stock.group_stock_user,stock.group_stock_manager"
        >
            <menuitem
                    name="Products"
                    id="shoes_dealer_products"
                    sequence="10"
                    action="shoes_dealer.shoes_dealer_product_template_action_product"
                    groups="stock.group_stock_user,stock.group_stock_manager"
            />
            <menuitem
                    name="Variants"
                    id="shoes_dealer_variants"
                    sequence="20"
                    action="shoes_dealer.shoes_dealer_stock_product_normal_action"
                    groups="stock.group_stock_user,stock.group_stock_manager"
            />
        </menuitem>
        <!-- Configuration (padre) -->
        <menuitem
                name="Configuration"
                id="shoes_dealer_configuration"
                sequence="100"
                groups="stock.group_stock_user,stock.group_stock_manager"
        >
            <!-- Configuration (submenus) -->
            <menuitem
                    name="Accounting"
                    id="shoes_dealer_configuration_accounting"
                    sequence="10"
                    groups="sales_team.group_sale_manager"

            />
            <menuitem
                    name="Inventory"
                    id="shoes_dealer_configuration_inventory"
                    sequence="20"
                    groups="stock.group_stock_user,stock.group_stock_manager"

            />
            <menuitem
                    name="Details"
                    id="shoes_dealer_configuration_details"
                    sequence="30"
                    groups="stock.group_stock_user,stock.group_stock_manager"

            />
        </menuitem>


    </menuitem>

</odoo>
