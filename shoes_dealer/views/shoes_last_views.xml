<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ACCIONES DE VENTANA: -->
    <record id="shoes_last_act_window" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="filter" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="limit">80</field>
        <field name="name">Shoes Lasts</field>
        <field name="res_model">shoes.last</field>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- LASTS INVENTORY CONFIG MENU: -->
    <record id="shoes_last_menu" model="ir.ui.menu">
        <field name="action" ref="shoes_last_act_window"/>
        <field name="active" eval="True"/>
        <field name="name">Shoes lasts</field>
        <field name="parent_id" ref="shoes_dealer.shoes_dealer_configuration_details"/>
        <field name="sequence">110</field>
        <field name="web_icon" eval="False"/>
    </record>

    <!-- FORM VIEW: -->
    <record id="shoes_last_default_form" model="ir.ui.view">
        <field name="name">shoes.last.default.form</field>
        <field name="model">shoes.last</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Last name ..."/>
                    </h1>
                    <group>
                        <group>
                            <field name="heel_id"/>
                            <field name="heel_height"/>
                            <field name="platform_height"/>
                        </group>
                        <group>
                            <field name="toe"/>
                            <field name="manufacturer_id" required="1"/>
                        </group>
                    </group>
                    <group name="shoes_material" string="Materials">
                        <group>
                            <field name="sole_material_main_id"/>
                            <field name="sole_material_secondary_id"/>
                            <field name="insole_material_id"/>
                            <field name="platform_material_id"/>
                        </group>
                        <group>
                            <field name="sole_material_main_percent"/>
                            <field name="sole_material_secondary_percent"/>
                            <field name="insole_material_percent"/>
                            <field name="platform_material_percent"/>
                        </group>
                    </group>
                    <group name="description" string="Description"></group>
                    <field name="description" placeholder="Description"/>
                </sheet>
            </form>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">form</field>
    </record>

    <!-- TREE VIEW: -->
    <record id="shoes_last_default_tree" model="ir.ui.view">
        <field name="name">shoes.last.default.tree</field>
        <field name="model">shoes.last</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="name"/>
                <field name="heel_id" optional="show"/>
                <field name="heel_height" optional="show"/>
                <field name="toe" optional="show"/>
                <field name="platform_height" optional="show"/>
                <field name="manufacturer_id" optional="show"/>
                <field name="sole_material_main_id" optional="hide"/>
                <field name="sole_material_secondary_id" optional="hide"/>
                <field name="insole_material_id" optional="hide"/>
                <field name="platform_material_id" optional="hide"/>
                <field name="sole_material_main_percent" optional="hide"/>
                <field name="sole_material_secondary_percent" optional="hide"/>
                <field name="insole_material_percent" optional="hide"/>
                <field name="platform_material_percent" optional="hide"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">list</field>
    </record>

    <!-- SEARCH VIEW: -->
    <record id="shoes_last_default_search" model="ir.ui.view">
        <field name="name">shoes.last.default.search</field>
        <field name="model">shoes.last</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Last" filter_domain="['|', ('name', 'ilike', self), ('manufacturer_id', 'ilike', self)]"/>
                <field name="manufacturer_id"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter name="group_by_manufacturer" string="Manufacturer" context="{'group_by': 'manufacturer_id'}"/>
                    <filter name="group_by_heel" string="Heel" context="{'group_by': 'heel_id'}"/>
                    <filter name="group_by_sole_material_main" string="Sole Material" context="{'group_by': 'sole_material_main_id'}"/>
                    <filter name="group_by_sole_material_secondary" string="Secondary Sole Material" context="{'group_by': 'sole_material_secondary_id'}"/>
                    <filter name="group_by_insole_material" string="Insole Material" context="{'group_by': 'insole_material_id'}"/>
                    <filter name="group_by_platform_material" string="Platform Material" context="{'group_by': 'platform_material_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
