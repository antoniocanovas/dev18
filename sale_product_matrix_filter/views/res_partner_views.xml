<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Partner customization & migration fields : -->
    <record id="sale_product_matrix_filter_inh_form" model="ir.ui.view">
        <field name="name">sale.product.matrix.filter.inh.form</field>
        <field name="model">res.partner</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Añadir campos de sale_filter_attribute_id -->
            <xpath expr="//sheet/group/group" position="inside">
                <field name="sale_filter_attribute_id" invisible="1"/>
                <field name="value_filter_ids"
                       domain="[('attribute_id','=',sale_filter_attribute_id)]"
                       widget="many2many_tags"
                />
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>

</odoo>