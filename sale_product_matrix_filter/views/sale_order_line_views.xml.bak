<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campo related disponible en las líneas -->
    <record id="view_order_line_tree_filtered" model="ir.ui.view">
        <field name="name">sale.order.line.tree.filtered</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="filtered_product_ids" invisible="1"/>
            </field>
        </field>
    </record>
    
    <!-- Campo related disponible en formulario de líneas -->
    <record id="view_order_line_form_filtered" model="ir.ui.view">
        <field name="name">sale.order.line.form.filtered</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_form"/>
        <field name="arch" type="xml">
            <field name="product_id" position="before">
                <field name="filtered_product_ids" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
