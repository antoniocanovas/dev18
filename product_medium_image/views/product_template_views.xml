<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_medium_image" model="ir.ui.view">
        <field name="name">product.template.form.inherit.medium.image</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='image_1920']" position="replace">
                <field name="image_1920" widget="image" options="{'convert_to_webp': True, 'preview_image': 'image_128'}" style="width: 128px; height: 128px; float: right;"/>
            </xpath>
        </field>
    </record>
</odoo>
