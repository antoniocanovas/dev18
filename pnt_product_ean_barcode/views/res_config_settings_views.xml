<odoo>
  <data>
    <record id="res_config_settings_view_form_inherit_pnt" model="ir.ui.view">
      <field name="name">res.config.settings.view.form.inherit.pnt_ean_barcode</field>
      <field name="model">res.config.settings</field>
      <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
      <field name="arch" type="xml">
        <!-- Apunta al bloque Barcode y mete el checkbox al final -->
        <xpath expr="//block[@name='barcode_setting_container']" position="inside">
          <setting id="pnt_internal_ean_sequence"
                   help="Internal EAN sequence">
            <field name="internal_ean_sequence"/>
          </setting>
          <setting id="pnt_public_ean_sequence"
                   help="EAN sequence">
            <field name="public_ean_sequence"/>
          </setting>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
