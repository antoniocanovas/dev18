<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard View -->
    <record id="pnt_assign_ean_wizard_form" model="ir.ui.view">
        <field name="name">pnt.assign.ean.wizard.form</field>
        <field name="model">pnt.assign.ean.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign EAN Code">
                <group>
                    <field name="ean_sequence_id" 
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="has_limit" invisible="1"/>
                    <field name="products_to_assign" invisible="1"/>
                    <field name="remaining_sequences" invisible="1"/>
                </group>
                <group>
                    <field name="warning_message" nolabel="1" widget="html"/>
                </group>
                <footer>
                    <button string="Assign EAN" 
                            type="object" 
                            name="action_assign_ean" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Product Template (multiple selection) -->
    <record id="pnt_action_assign_ean_template" model="ir.actions.act_window">
        <field name="name">Assign EAN</field>
        <field name="res_model">pnt.assign.ean.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list</field>
    </record>

    <!-- Action for Product Variant (multiple selection) -->
    <record id="pnt_action_assign_ean_product" model="ir.actions.act_window">
        <field name="name">Assign EAN</field>
        <field name="res_model">pnt.assign.ean.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
