<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pnt_sequence_view" model="ir.ui.view">
        <field name="model">ir.sequence</field>
        <field name="arch" type="xml">
            <form string="Sequences">
                <sheet>
                    <group>
                        <group>
                            <field name="pnt_ean14_prefix"/>
                            <field name="prefix"/>
                        </group>
                        <group>
                            <field name="padding"/>
                            <field name="number_increment"/>
                            <field name="number_next_actual" string="Next Number"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inherit standard ir.sequence form view to add EAN fields -->
    <record id="pnt_ir_sequence_form_inherit" model="ir.ui.view">
        <field name="name">ir.sequence.form.inherit.pnt</field>
        <field name="model">ir.sequence</field>
        <field name="inherit_id" ref="base.sequence_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="pnt_is_ean"/>
                <field name="pnt_ean14_prefix" invisible="not pnt_is_ean"/>
            </xpath>
            <xpath expr="//field[@name='number_next_actual']" position="after">
                <field name="pnt_max_sequence" invisible="not pnt_is_ean"/>
                <field name="pnt_remaining_sequences" invisible="not pnt_is_ean or pnt_max_sequence == 0" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Action to list EAN sequences -->
    <record id="pnt_action_ean_sequences" model="ir.actions.act_window">
        <field name="name">EAN Sequences</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('pnt_is_ean', '=', True)]</field>
        <field name="context">{'default_pnt_is_ean': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new EAN sequence
            </p>
        </field>
    </record>
</odoo>
