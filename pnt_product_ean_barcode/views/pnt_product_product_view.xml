<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pnt_product_product_ean" model="ir.ui.view">
        <field name="name">product.product.form.view.inherit</field>
        <field name="model">product.product</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button string="Generate EAN" 
                        type="object" 
                        name="action_open_assign_ean_wizard"
                        invisible="type == 'service' or barcode != False"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//header" position="after">
                <div class="alert alert-info mb-0" role="alert"
                     invisible="pnt_ean_required == False or barcode != False">
                    EAN barcode required for this product, please click Generate EAN button to assign.
                </div>
            </xpath>

            <xpath expr="//field[@name='barcode']" position="after">
                <field name="pnt_ean_required" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
