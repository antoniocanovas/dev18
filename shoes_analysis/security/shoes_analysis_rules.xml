<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- REGLA 1: Director Comercial - Acceso Total -->
    <!-- ========================================== -->
    <record id="shoes_analysis_rule_director" model="ir.rule">
        <field name="name">Shoes Analysis: Director Comercial - Full Access</field>
        <field name="model_id" ref="model_shoes_analysis"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_shoes_analysis_director'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ========================================== -->
    <!-- REGLA 2: Comercial - Lectura/Escritura/Creación -->
    <!-- ========================================== -->
    <record id="shoes_analysis_rule_manager_read_write" model="ir.rule">
        <field name="name">Shoes Analysis: Comercial - Read/Write/Create</field>
        <field name="model_id" ref="model_shoes_analysis"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_shoes_analysis_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ========================================== -->
    <!-- REGLA 3: Comercial - Solo mis clientes (Lectura) -->
    <!-- ========================================== -->
    <record id="shoes_analysis_rule_user_readonly" model="ir.rule">
        <field name="name">Shoes Analysis: Comercial - My Reports or Public (Read Only)</field>
        <field name="model_id" ref="model_shoes_analysis"/>
        <field name="domain_force">['|', ('referrer_id', '=', user.id), ('public', '=', True)]</field>
        <field name="groups" eval="[(4, ref('group_shoes_analysis_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
