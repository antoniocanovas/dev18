<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_shoes_dealer" model="ir.module.category">
        <field name="name">Shoes dealer</field>
        <field name="description">Gestión de permisos para el sistema de mayorista de calzado</field>
        <field name="sequence">6</field>
    </record>

    <record id="group_shoes_analysis_user" model="res.groups">
        <field name="name">Solo mis clientes e informes públicos</field>
        <field name="category_id" ref="module_category_shoes_dealer"/>
    </record>

    <record id="group_shoes_analysis_manager" model="res.groups">
        <field name="name">Gestor</field>
        <field name="category_id" ref="module_category_shoes_dealer"/>
        <field name="implied_ids" eval="[(4, ref('group_shoes_analysis_user'))]"/>
    </record>

    <record id="group_shoes_analysis_director" model="res.groups">
        <field name="name">Director</field>
        <field name="category_id" ref="module_category_shoes_dealer"/>
        <field name="implied_ids" eval="[(4, ref('group_shoes_analysis_manager'))]"/>
    </record>

    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('shoes_analysis.group_shoes_analysis_user'))]"/>
    </record>

    <record id="sales_team.group_sale_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('shoes_analysis.group_shoes_analysis_director'))]"/>
    </record>
</odoo>