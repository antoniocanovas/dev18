<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shoes Sales Statistics Report -->
    <record id="shoes_sales_statistics_report" model="account.report">
        <field name="name">Shoes Sales Statistics</field>
        <field name="custom_handler_model_name">shoes.sales.statistics.report</field>
        <field name="filter_date_range" eval="True"/>
        <field name="filter_comparison" eval="True"/>
        <field name="availability_condition">base.group_user</field>
    </record>

    <!-- Action for Shoes Sales Statistics Report -->
    <record id="action_shoes_sales_statistics_report" model="ir.actions.client">
        <field name="name">Shoes Sales Statistics</field>
        <field name="tag">account_report</field>
        <field name="context" eval="{'model': 'account.report', 'id': ref('shoes_sales_statistics_report')}"/>
    </record>

</odoo>
