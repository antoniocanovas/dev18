<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_shoes_analysis" model="report.paperformat">
        <field name="name">Shoes Analysis A4</field>
        <field name="default" eval="False" />
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>      <!-- Reducido a 10mm -->
        <field name="margin_bottom">25</field>   <!-- Espacio para footer -->
        <field name="margin_left">10</field>     <!-- Márgenes laterales reducidos -->
        <field name="margin_right">10</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">0</field>   <!-- Sin header -->
        <field name="dpi">90</field>
    </record>

    <!-- Acción del Informe -->
    <record id="action_report_shoes_analysis" model="ir.actions.report">
        <field name="name">Shoe Analysis</field>
        <field name="model">shoes.analysis</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">shoes_analysis.report_shoes_analysis_template</field>
        <field name="report_file">shoes_analysis.report_shoes_analysis_template</field>
        <field name="paperformat_id" ref="shoes_analysis.paperformat_shoes_analysis"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>

    <template id="shoes_analysis_custom_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <!-- Header vacío (no necesitamos header) -->
        <div class="header"/>

        <!-- Contenido del informe -->
        <div class="article" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id">
            <t t-out="0"/>
        </div>

        <!-- Footer con título del informe y paginación -->
        <div class="footer">
            <div class="text-muted border-top pt-2">
                <div class="row">
                    <div class="col-8 text-start">
                        <strong><span t-esc="o.name"/></strong>
<!--                        <span class="ms-2">-</span>-->
<!--                        <span class="ms-2"><span t-esc="o.type"/></span>-->
                    </div>
                    <div class="col-4 text-end">
                        Page <span class="page"/> / <span class="topage"/>
                    </div>
                </div>
            </div>
        </div>
    </template>

    <!-- Plantilla QWeb del Informe -->
    <template id="report_shoes_analysis_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="shoes_analysis.shoes_analysis_custom_layout">
                    <div class="page">
                        <!-- Título, Subtítulo y Fecha -->
                        <div class="text-center">
<!--                            <h1><span t-field="doc.name"/></h1>-->
                            <h3><span t-field="doc.type"/></h3>
                            <div t-if="doc.type == 'salesman_customers' and doc.referrer_id" class="mt-2 mb-3">
                                <span class="me-1" style="padding: 4px 12px; background-color: #f0f0f0; color: #000; border-radius: 50rem;">
                                    <t t-esc="doc.referrer_id.name"/>
                                </span>
                            </div>
                            <p>Última actualización: <span t-field="doc.write_date" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></p>
                            <div t-if="doc.manufacturer_ids" class="mt-2 mb-3">
                                <t t-foreach="doc.manufacturer_ids" t-as="manufacturer">
                                    <span class="me-1" style="padding: 4px 12px; background-color: #f0f0f0; color: #000; border-radius: 50rem;">
                                        <t t-esc="manufacturer.name"/>
                                    </span>
                                </t>
                            </div>
                        </div>

                        <!-- Resumen HTML (si existe) -->
                        <div class="mt-4" t-if="doc.resume_html" t-raw="doc.resume_html"/>

                        <!-- Contenido HTML -->
                        <t t-raw="doc.analysis_html"/>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
