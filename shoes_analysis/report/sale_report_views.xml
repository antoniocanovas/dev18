<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sale Report Search View -->
    <record id="view_order_product_search_inherit_shoes" model="ir.ui.view">
        <field name="name">sale.report.search.inherit.shoes</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_search"/>
        <field name="arch" type="xml">
            <!-- Add filters -->
             <filter name="Sales" position="after">
                <separator/>
                <filter string="Pairs" name="pairs"
                        domain="[('pnt_is_pair', '=', True)]"
                        help="Show only pair products"/>
                <filter string="Assortments" name="assortments"
                        domain="[('pnt_is_assortment', '=', True)]"
                        help="Show only assortment products"/>
            </filter>

            <!-- Add group by options -->
            <filter name="product_tmpl_id" position="after">
                <filter string="Manufacturer" name="manufacturer"
                        context="{'group_by': 'pnt_manufacturer_id'}"/>
                <filter string="Material" name="material"
                        context="{'group_by': 'pnt_material_id'}"/>
                <filter string="Last" name="last"
                        context="{'group_by': 'pnt_shoes_last_id'}"/>
                <filter string="Shoes Model" name="shoes_model"
                        context="{'group_by': 'pnt_shoes_model_material'}"/>
            </filter>

            <!-- Add search fields -->
            <field name="product_id" position="after">
                <field name="pnt_manufacturer_id"/>
                <field name="pnt_material_id"/>
                <field name="pnt_shoes_last_id"/>
                <field name="pnt_shoes_model_material"/>
            </field>
        </field>
    </record>

    <!-- Inherit Sale Report Pivot View -->
    <record id="view_order_product_pivot_inherit_shoes" model="ir.ui.view">
        <field name="name">sale.report.pivot.inherit.shoes</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_pivot"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="pnt_manufacturer_id" type="row"/>
                <field name="pnt_material_id" type="row"/>
                <field name="pnt_shoes_last_id" type="row"/>
                <field name="pnt_shoes_model_material" type="row"/>
                <field name="pnt_pairs_count" type="measure"/>
                <field name="pnt_assortment_count" type="measure"/>
            </field>
        </field>
    </record>

    <!-- Inherit Sale Report Graph View -->
    <record id="view_order_product_graph_inherit_shoes" model="ir.ui.view">
        <field name="name">sale.report.graph.inherit.shoes</field>
        <field name="model">sale.report</field>
        <field name="inherit_id" ref="sale.view_order_product_graph"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="pnt_pairs_count" type="measure"/>
                <field name="pnt_assortment_count" type="measure"/>
            </field>
        </field>
    </record>

</odoo>
