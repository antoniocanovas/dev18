<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Account Invoice Report Search View -->
    <record id="view_account_invoice_report_search_inherit_shoes" model="ir.ui.view">
        <field name="name">account.invoice.report.search.inherit.shoes</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_search"/>
        <field name="arch" type="xml">
            <!-- Add filters -->
            <filter name="creditnote" position="after">
                <separator/>
                <filter string="Pairs" name="pairs"
                        domain="[('pnt_is_pair', '=', True)]"
                        help="Show only pair products"/>
                <filter string="Assortments" name="assortments"
                        domain="[('pnt_is_assortment', '=', True)]"
                        help="Show only assortment products"/>
            </filter>

            <!-- Add group by options -->
            <filter name="category_product" position="after">
                <filter string="Manufacturer" name="manufacturer"
                        context="{'group_by': 'pnt_manufacturer_id'}"/>
                <filter string="Material" name="material"
                        context="{'group_by': 'pnt_material_id'}"/>
                <filter string="Last" name="last"
                        context="{'group_by': 'pnt_shoes_last_id'}"/>
                <filter string="Shoes Model" name="shoes_model"
                        context="{'group_by': 'pnt_shoes_model_material'}"/>
            </filter>

            <!-- Add search fields -->
            <field name="product_categ_id" position="after">
                <field name="pnt_manufacturer_id"/>
                <field name="pnt_material_id"/>
                <field name="pnt_shoes_last_id"/>
                <field name="pnt_shoes_model_material"/>
            </field>
        </field>
    </record>

    <!-- Inherit Account Invoice Report Pivot View -->
    <record id="view_account_invoice_report_pivot_inherit_shoes" model="ir.ui.view">
        <field name="name">account.invoice.report.pivot.inherit.shoes</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_pivot"/>
        <field name="arch" type="xml">
            <field name="invoice_date" position="after">
                <field name="pnt_manufacturer_id" type="row"/>
                <field name="pnt_material_id" type="row"/>
                <field name="pnt_shoes_last_id" type="row"/>
                <field name="pnt_shoes_model_material" type="row"/>
                <field name="pnt_pairs_count" type="measure"/>
                <field name="pnt_assortment_count" type="measure"/>
            </field>
        </field>
    </record>

    <!-- Inherit Account Invoice Report Graph View -->
    <record id="view_account_invoice_report_graph_inherit_shoes" model="ir.ui.view">
        <field name="name">account.invoice.report.graph.inherit.shoes</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.view_account_invoice_report_graph"/>
        <field name="arch" type="xml">
            <field name="product_categ_id" position="after">
                <field name="pnt_pairs_count" type="measure"/>
                <field name="pnt_assortment_count" type="measure"/>
            </field>
        </field>
    </record>

    <!-- Extend List View with custom fields -->
    <record id="account_invoice_report_view_tree_inherit_shoes" model="ir.ui.view">
        <field name="name">account.invoice.report.view.list.inherit.shoes</field>
        <field name="model">account.invoice.report</field>
        <field name="inherit_id" ref="account.account_invoice_report_view_tree"/>
        <field name="arch" type="xml">
            <field name="product_id" position="after">
                <field name="pnt_manufacturer_id" optional="hide"/>
                <field name="pnt_material_id" optional="hide"/>
                <field name="pnt_shoes_last_id" optional="hide"/>
                <field name="pnt_shoes_model_material" optional="hide"/>
                <field name="pnt_pairs_count" optional="hide" sum="Total"/>
                <field name="pnt_assortment_count" optional="hide" sum="Total"/>
            </field>
        </field>
    </record>

</odoo>
