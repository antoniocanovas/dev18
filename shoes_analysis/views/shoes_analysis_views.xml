<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista List -->
    <record id="view_shoes_analysis_list" model="ir.ui.view">
        <field name="name">shoes.analysis.list</field>
        <field name="model">shoes.analysis</field>
        <field name="arch" type="xml">
            <list string="Shoes Analysis">
                <header>
                    <button name="update_shoes_analysis"
                            string="Update"
                            type="object"
                            class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="shoes_campaign_id"/>
                <field name="shoes_campaign_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="view_shoes_analysis_form" model="ir.ui.view">
        <field name="name">shoes.analysis.form</field>
        <field name="model">shoes.analysis</field>
        <field name="arch" type="xml">
            <form string="Shoes Analysis">
                <header>
                    <button name="update_shoes_analysis"
                            string="Update"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Analysis Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="shoes_campaign_id"/>
                            <field name="shoes_campaign_ids" widget="many2many_tags"/>
                            <field name="total"/>
                            <field name="type" groups="base.group_no_one"/>
                            <field name="write_date"/>
                        </group>
                        <group>
                            <field name="resume_html" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Report" invisible="type in ['product_ranking']">
                            <field name="analysis_html" nolabel="1" readonly="1"/>
                            <field name="line_ids" invisible="type in ['salesman_sales_delivery']">
                                <list>
                                <!-- <list editable="bottom"> -->
                                    <field name="name" optional="hide"/>
                                    <field name="product_tmpl_id" optional="show" />
                                    <field name="shoes_model_material_id" optional="hide"/>
                                    <field name="shoes_task_id" optional="hide"/>
                                    <field name="shoes_last_id" optional="hide"/>
                                    <field name="data" optional="hide"/>
                                    <field name="data_html"/>
                                    <field name="total" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Ranking" invisible="type not in ['product_ranking']">
                            <field name="ranking_line_ids">
                                <list>
                                    <field name="ranking"/>
                                    <field name="image" widget="image" options="{'size':[0,90]}"/>
                                    <field name="product_tmpl_id"/>
                                    <field name="shoes_model_material_id"/>
                                    <field name="shoes_last_id" column_invisible="1"/>
                                    <field name="pairs_count_sale"/>
                                    <field name="pairs_count_cancel"/>
                                    <field name="pairs_count_net"/>
                                    <field name="sale_net_amount" widget="monetary"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción 1: Situación de ventas y entregas por agente -->
    <record id="action_sales_delivery_by_agent" model="ir.actions.act_window">
        <field name="name">Situación de ventas y entregas por agente</field>
        <field name="res_model">shoes.analysis</field>
        <field name="context">{'default_type': 'salesman_sales_delivery'}</field>
        <field name="domain">[('type','=','salesman_sales_delivery')]</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo análisis de ventas y entregas por agente
            </p>
        </field>
    </record>

