<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Simplified filter templates for now -->
    <template id="shoes_statistics_filters" inherit_id="account_reports.main_template">
        <xpath expr="//div[@class='o_account_reports_header']" position="after">
            <div class="o_account_reports_custom_filters" style="padding: 10px;">
                <h6>Custom Filters</h6>
                <div class="row">
                    <div class="col-md-4">
                        <label>Brand:</label>
                        <select id="brand_filter" class="form-control" multiple="multiple">
                            <!-- Options will be populated via JavaScript -->
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label>Sales Team:</label>
                        <select id="team_filter" class="form-control" multiple="multiple">
                            <!-- Options will be populated via JavaScript -->
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label>Salesman:</label>
                        <select id="salesman_filter" class="form-control" multiple="multiple">
                            <!-- Options will be populated via JavaScript -->
                        </select>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
