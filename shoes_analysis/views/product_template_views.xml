<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- VISTA FORM: -->
    <record id="shoes_ranking_inh_form" model="ir.ui.view">
        <field name="name">shoes.ranking.inh.form</field>
        <field name="model">product.template</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_dealer.shoes_dealer_product_inh_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <!-- Código Material-Fabricante (nombre de shoes.model.material): -->
            <xpath expr="//field[@name='list_price']" position="after">
                <field name="shoes_ranking_ids" widget="many2many_tags"
                       readonly="1" invisible="not is_pair"/>
                <field name="shoes_assortment_ranking_ids" widget="many2many_tags" string="Shoes ranking"
                       readonly="1" invisible="not is_assortment"/>
            </xpath>
        </field>
    </record>

</odoo>
