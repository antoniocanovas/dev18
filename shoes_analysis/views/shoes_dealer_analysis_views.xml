<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST view -->
    <record id="shoes_dealer_analysis_list_view" model="ir.ui.view">
        <field name="name">shoes.dealer.analysis.list</field>
        <field name="model">shoes.dealer.analysis</field>
        <field name="arch" type="xml">
            <list string="Shoes Analysis" create="false" edit="false">
                <field name="date"/>
                <field name="sale_id"/>
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="size_value_id"/>
                <field name="color_value_id"/>
                <field name="sale_qty"/>
                <field name="delivery_qty"/>
                <field name="invoice_qty"/>
                <field name="campaign_id"/>
                <field name="brand_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Search view -->
    <record id="shoes_dealer_analysis_search_view" model="ir.ui.view">
        <field name="name">shoes.dealer.analysis.search</field>
        <field name="model">shoes.dealer.analysis</field>
        <field name="arch" type="xml">
            <search string="Shoes Analysis">
                <field name="partner_id"/>
                <field name="product_id"/>
                <field name="sale_product_id"/>
                <field name="campaign_id"/>
                <field name="brand_id"/>
                <field name="size_value_id"/>
                <field name="color_value_id"/>
                <field name="salesman_id"/>
                
                <separator/>
                <filter name="current_year" string="Current Year"
                    domain="[('date', '&gt;=', datetime.datetime.now().strftime('%%Y-01-01'))]"/>
                <filter name="current_month" string="Current Month"
                    domain="[('date', '&gt;=', datetime.datetime.now().strftime('%%Y-%%m-01'))]"/>
                
                <separator/>
                <filter name="pairs" string="Pairs Only"
                    domain="[('assortment_attribute_id', '=', False)]"/>
                <filter name="assortments" string="Assortments Only"
                    domain="[('assortment_attribute_id', '!=', False)]"/>
                
                <separator/>
                <filter name="sale_state" string="Sale Orders"
                    domain="[('state', 'in', ['sale', 'done'])]"/>
                
                <group expand="0" string="Group By">
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_campaign" string="Campaign" context="{'group_by': 'campaign_id'}"/>
                    <filter name="group_brand" string="Brand" context="{'group_by': 'brand_id'}"/>
                    <filter name="group_size" string="Size" context="{'group_by': 'size_value_id'}"/>
                    <filter name="group_color" string="Color" context="{'group_by': 'color_value_id'}"/>
                    <filter name="group_salesman" string="Salesman" context="{'group_by': 'salesman_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Pivot view -->
    <record id="shoes_dealer_analysis_pivot_view" model="ir.ui.view">
        <field name="name">shoes.dealer.analysis.pivot</field>
        <field name="model">shoes.dealer.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Shoes Analysis">
                <field name="campaign_id" type="row"/>
                <field name="brand_id" type="row"/>
                <field name="date" interval="month" type="col"/>
                <field name="sale_qty" type="measure"/>
                <field name="delivery_qty" type="measure"/>
                <field name="invoice_qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph view -->
    <record id="shoes_dealer_analysis_graph_view" model="ir.ui.view">
        <field name="name">shoes.dealer.analysis.graph</field>
        <field name="model">shoes.dealer.analysis</field>
        <field name="arch" type="xml">
            <graph string="Shoes Analysis" type="bar">
                <field name="campaign_id"/>
                <field name="sale_qty" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Action -->
    <record id="shoes_dealer_analysis_action" model="ir.actions.act_window">
        <field name="name">Shoes Analysis</field>
        <field name="res_model">shoes.dealer.analysis</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="shoes_dealer_analysis_search_view"/>
        <field name="context">{'search_default_current_year': 1, 'search_default_sale_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sales analysis data found.
            </p>
            <p>
                This view shows detailed analysis of shoes sales including pairs and assortments breakdown.
            </p>
        </field>
    </record>

</odoo>
