<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add Analysis menu to Shoes Dealer before Configuration -->
    <menuitem
        id="shoes_analysis_menu"
        name="Analysis"
        parent="shoes_dealer.shoes_dealer_main_menu"
        sequence="90"
        groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
    >
        <!-- Pair sales submenu -->
        <menuitem
            id="shoes_pair_sales_menu"
            name="Pair sales"
            sequence="10"
            action="shoes_analysis.shoes_dealer_analysis_action"
            groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
        />
        
        <!-- Sales statistics submenu (financial report style) -->
        <menuitem
            id="shoes_sales_statistics_menu"
            name="Sales statistics"
            sequence="20"
            action="shoes_analysis.action_shoes_sales_statistics_report"
            groups="sales_team.group_sale_salesman,sales_team.group_sale_manager"
        />
    </menuitem>

</odoo>
