<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_product_sku_inh_form" model="ir.ui.view">
        <field name="name">shoes.product.sku.inh.form</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_dealer.shoes_dealer_inh_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='shoes_dealer']/group" position="after">
                <group string="SKU Code" name="shoes_dealer_sku">
                    <group name="shoes_sku_code" string="Codes">
                        <label for="shoes_code_product"/>
                        <div class="o_row">
                            <field name="shoes_code_product_prefix" placeholder="prefix"/>
                            <field name="shoes_code_product" required="1"/>
                        </div>
                        <label for="shoes_code_manufacturer"/>
                        <div class="o_row">
                            <field name="shoes_code_manufacturer_prefix" placeholder="prefix"/>
                            <field name="shoes_code_manufacturer" required="1"/>
                        </div>
                        <label for="shoes_code_color"/>
                        <div class="o_row">
                            <field name="shoes_code_color_prefix" placeholder="prefix"/>
                            <field name="shoes_code_color" required="1"/>
                        </div>
                        <label for="shoes_code_material"/>
                        <div class="o_row">
                            <field name="shoes_code_material_prefix" placeholder="prefix"/>
                            <field name="shoes_code_material" required="1"/>
                        </div>
                        <label for="shoes_code_campaign"/>
                        <div class="o_row">
                            <field name="shoes_code_campaign_prefix" placeholder="prefix"/>
                            <field name="shoes_code_campaign" required="1"/>
                        </div>
                        <field name="shoes_sku_update"/>
                    </group>

                    <group name="shoes_sku_sequence" string="Sequence">
                        <field name="shoes_sku_item_ids" required="1" nolabel="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name" nolabel="1"/>
                            </list>
                        </field>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
