<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_product_sku_inh_form" model="ir.ui.view">
        <field name="name">shoes.product.sku.inh.form</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_dealer.shoes_dealer_inh_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='shoes_dealer']/group" position="after">
                <group string="SKU" name="shoes_dealer_sku">
                    <field name="shoes_sku_item_ids"required="1">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                            </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
