<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="shoes_sample_list_view" model="ir.ui.view">
        <field name="name">shoes.sample.list</field>
        <field name="model">shoes.sample</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="image" widget="image" string=" " options="{'size': [40, 40]}" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="partner_id"/>
                <field name="shoes_campaign_id"/>
                <field name="shoes_sku_id"
                       domain="[('shoes_campaign_id', '=', shoes_campaign_id)]"/>
                <field name="shoes_task_id" optional="show"/>
                <field name="type"/>
                <field name="date"/>
                <button name="action_open_form" type="object"
                        icon="fa-external-link" title="Open"
                        class="btn-sm btn-secondary" string=""/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="shoes_sample_form_view" model="ir.ui.view">
        <field name="name">shoes.sample.form</field>
        <field name="model">shoes.sample</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Referrer">
                            <field name="partner_id"/>
                            <field name="shoes_campaign_id"/>
                            <field name="shoes_sku_id"
                                   domain="[('shoes_campaign_id', '=', shoes_campaign_id)]"/>
                            <field name="type"/>
                            <field name="date"/>
                        </group>
                        <group string="Product">
                            <field name="shoes_task_id" readonly="1"/>
                            <field name="product_tmpl_set_id" readonly="1"/>
                            <field name="product_tmpl_single_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Images" name="images">
                            <field name="product_image_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="image_1920" widget="image"
                                           options="{'size': [90, 90]}"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="shoes_sample_search_view" model="ir.ui.view">
        <field name="name">shoes.sample.search</field>
        <field name="model">shoes.sample</field>
        <field name="arch" type="xml">
            <search string="Samples">
                <field name="partner_id"/>
                <field name="shoes_sku_id"/>
                <field name="shoes_campaign_id"/>
                <field name="product_brand_id"/>
                <field name="shoes_task_id"/>
                <separator/>
                <filter string="Izquierdo" name="filter_left"
                        domain="[('type', '=', 'I')]"/>
                <filter string="Derecho" name="filter_right"
                        domain="[('type', '=', 'D')]"/>
                <filter string="Par completo" name="filter_pair"
                        domain="[('type', '=', 'P')]"/>
                <separator/>
                <filter string="Campaign" name="group_campaign"
                        context="{'group_by': 'shoes_campaign_id'}"/>
                <filter string="Brand" name="group_brand"
                        context="{'group_by': 'product_brand_id'}"/>
                <filter string="Referrer" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Model" name="group_task"
                        context="{'group_by': 'shoes_task_id'}"/>
                <filter string="Date" name="group_date"
                        context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="shoes_sample_action" model="ir.actions.act_window">
        <field name="name">Samples</field>
        <field name="res_model">shoes.sample</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="shoes_sample_search_view"/>
        <field name="context">{'search_default_group_campaign': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No samples found. Create one!
            </p>
        </field>
    </record>

    <!-- MENU in Design -->
    <menuitem
        name="Samples"
        id="shoes_sample_menu"
        parent="shoes_dealer.shoes_dealer_design_menu"
        sequence="30"
        action="shoes_sample_action"
        groups="project.group_project_user"
    />

</odoo>
