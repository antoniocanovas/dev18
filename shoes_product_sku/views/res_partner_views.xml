<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_stock_referrer_partner_inh_form" model="ir.ui.view">
        <field name="name">shoes.stock.referrer.partner.inh.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="shoes_samples"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_ship_demo"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users">
                    <field name="shoes_referrer_count" widget="statinfo" string="Shoes demo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
