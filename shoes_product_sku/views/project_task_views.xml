<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Task customization: -->
    <record id="shoes_product_sku_task_inh_form" model="ir.ui.view">
        <field name="name">shoes.product.sku.task.inh.form</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_campaign.shoes_campaign_task_inh_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_deadline']" position="before">
                <field name="shoes_default_code_prefix" class="h2"/>
                <field name="shoes_default_code_sufix" class="h2"/>
            </xpath>

            <!-- SKU smart button -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_shoes_sku"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-barcode"
                        invisible="not is_shoes_campaign">
                    <field name="shoes_sku_count" widget="statinfo" string="SKU"/>
                </button>
            </xpath>

            <!-- Import images button in header -->
            <xpath expr="//header" position="inside">
                <button name="action_open_sku_image_wizard"
                        type="object"
                        string="Import SKU Images"
                        class="btn-secondary"
                        invisible="shoes_sku_count == 0"/>
                <button name="action_open_sample_wizard"
                        type="object"
                        string="Samples"
                        class="btn-secondary"
                        invisible="shoes_sku_count == 0"/>
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>

    <!-- List view: add Import Images button column -->
    <record id="shoes_product_sku_task_inh_list" model="ir.ui.view">
        <field name="name">shoes.product.sku.task.inh.list</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="shoes_campaign.shoes_campaign_task_inh_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="shoes_sku_count" column_invisible="1"/>
                <button name="action_open_sku_image_wizard"
                        type="object"
                        icon="fa-camera"
                        string="Images"
                        class="btn-sm btn-info"
                        invisible="shoes_sku_count == 0"/>
                <button name="action_open_sample_wizard"
                        type="object"
                        icon="fa-users"
                        string="Samples"
                        class="btn-sm btn-warning"
                        invisible="shoes_sku_count == 0"/>
            </xpath>
        </field>
    </record>

</odoo>
