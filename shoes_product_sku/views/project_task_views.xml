<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Task customization: -->
    <record id="shoes_product_sku_task_inh_form" model="ir.ui.view">
        <field name="name">shoes.product.sku.task.inh.form</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_campaign.shoes_campaign_task_inh_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='date_deadline']" position="before">

                    <field name="shoes_default_code_prefix" class="h2"/>
                    <field name="shoes_default_code_sufix" class="h2"/>

            </xpath>

        </field>
        <field name="priority">99</field>
    </record>

</odoo>
