<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_sample_task_wizard_form" model="ir.ui.view">
        <field name="name">shoes.sample.task.wizard.form</field>
        <field name="model">shoes.sample.task.wizard</field>
        <field name="arch" type="xml">
            <form string="Samples">
                <sheet>
                    <group>
                        <field name="task_id" readonly="1"/>
                    </group>
                    <field name="cell_ids" widget="shoes_sample_matrix" nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_save" type="object"
                            string="Guardar" class="btn-primary"/>
                    <button special="cancel" string="Cerrar"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
