<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_sku_photo_reduce_wizard_form" model="ir.ui.view">
        <field name="name">shoes.sku.photo.reduce.wizard.form</field>
        <field name="model">shoes.sku.photo.reduce.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Photo Field Deletion">
                <div class="alert alert-danger" role="alert">
                    <field name="message" readonly="1" nolabel="1"/>
                </div>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm deletion" class="btn-danger"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
