<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="shoes_shippingmark_res_partner_form" model="ir.ui.view">
        <field name="name">shoes.shippingmark.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="sale_order_type.res_partner_sale_type_form_view"/>
        <field name="arch" type="xml">
            <field name="sale_type" position="after">
                <field name="shoes_shippingmark_ids"
                       widget="many2many_tags"
                       string="Exclusive Shipping Marks"
                       help="If empty, this customer can be served with any Shipping Mark. If filled, only the included ones will be allowed."
                       invisible="not is_company"/>
            </field>
        </field>
    </record>

</odoo>
