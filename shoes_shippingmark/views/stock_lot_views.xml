<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="shoes_shippingmark_stock_lot_form" model="ir.ui.view">
        <field name="name">shoes.shippingmark.stock.lot.form</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group[1]" position="inside">
                <field name="shippingmark_id"/>
            </xpath>
        </field>
    </record>

    <record id="shoes_shippingmark_stock_lot_tree" model="ir.ui.view">
        <field name="name">shoes.shippingmark.stock.lot.tree</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="shippingmark_id" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
