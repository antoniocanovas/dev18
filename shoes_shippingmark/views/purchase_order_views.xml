<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Shipping Mark column in purchase order lines (linked from sale order) -->
    <record id="shoes_shippingmark_purchase_order_form" model="ir.ui.view">
        <field name="name">shoes.shippingmark.purchase.order.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='products']/field[@name='order_line']/list[1]/field[@name='product_qty']" position="attributes">
                <attribute name="readonly">sale_line_id</attribute>
            </xpath>
            <xpath expr="//page[@name='products']/field[@name='order_line']/list[1]/field[@name='product_id']" position="after">
                <field name="pnt_sale_type_id" string="Shipping Mark" optional="show"
                       help="Shipping mark inherited from the sale order, or manually assigned. Only editable for new lines not linked to a sale order."
                       readonly="sale_line_id"
                       required="not sale_line_id"/>
            </xpath>
        </field>
    </record>

</odoo>
