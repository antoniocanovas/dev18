<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ─── REGLA RESTRICTIVA: Operarios de almacén ─────────────────────────── -->
        <!--
            Los operarios (stock.group_stock_user) solo ven albaranes que cumplen
            AL MENOS una de estas condiciones:
              1. El tipo de operación NO es salida (recepciones, internos…)
              2. La validación comercial está aprobada
              3. El albarán ya está en estado 'done' o 'cancel' (histórico)
            Los albaranes rechazados (rejected) también quedan ocultos para el almacén,
            igual que los pendientes, hasta que el comercial los vuelva a aprobar.
        -->
        <record id="rule_picking_warehouse_visibility" model="ir.rule">
            <field name="name">Albaranes: Visibilidad restringida para Operarios de Almacén</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
            <field name="domain_force">
                ['|', ('picking_type_id.code', '!=', 'outgoing'),
                 '|', ('commercial_validation', '=', 'approved'),
                      ('state', 'in', ['done', 'cancel'])]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ─── REGLA BYPASS: Gestores de almacén ───────────────────────────────── -->
        <!--
            stock.group_stock_manager implica stock.group_stock_user, por lo que
            también queda sujeto a la regla restrictiva anterior.
            Esta regla sin restricción (1=1) anula esa limitación para los gestores,
            ya que Odoo aplica OR entre las reglas de distintos grupos del mismo usuario.
        -->
        <record id="rule_picking_manager_bypass" model="ir.rule">
            <field name="name">Albaranes: Acceso total para Gestores de Almacén</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('stock.group_stock_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ─── REGLA RESTRICTIVA: Comerciales con acceso a sus pedidos ─────────── -->
        <!--
            Espejo del permiso de ventas "Solo mis documentos" (group_sale_salesman):
            el comercial solo ve albaranes de salida cuyo pedido de venta le pertenece.
            No está restringido en recepciones ni transferencias internas.
            El campo sale_id en stock.picking lo aporta el módulo sale_stock.
        -->
        <record id="rule_picking_salesman_own" model="ir.rule">
            <field name="name">Albaranes: Solo propios para Comerciales (mis pedidos)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
            <field name="domain_force">
                ['|', ('picking_type_id.code', '!=', 'outgoing'),
                 '|', ('sale_id.user_id', '=', user.id),
                      ('state', 'in', ['done', 'cancel'])]
            </field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ─── REGLA BYPASS: Comerciales con acceso a todos los pedidos ─────────── -->
        <!--
            Espejo del permiso de ventas "Todos los documentos" (group_sale_salesman_all_leads).
            Ese grupo implica group_sale_salesman, por lo que un usuario con acceso total
            tiene ambas reglas. Odoo aplica OR → el bypass gana y ve todo.
        -->
        <record id="rule_picking_salesman_all_bypass" model="ir.rule">
            <field name="name">Albaranes: Acceso total para Comerciales (todos los pedidos)</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
