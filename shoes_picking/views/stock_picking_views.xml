<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         FORM VIEW — botones de aprobación/rechazo + barra de estado comercial
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_picking_form_commercial_validation" model="ir.ui.view">
        <field name="name">stock.picking.form.commercial.validation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <!--
                Botones justo antes del primer "Validate".
                Visibles para cualquier comercial (group_sale_salesman cubre basic y all_leads).
                Aprobar: activo cuando pending o rechazado (para corregir un error de rechazo).
                Rechazar: activo cuando pending o aprobado (para corregir un error de aprobación).
                No se muestran en estados terminales (done/cancel) ni en operaciones no salida.
            -->
            <!--
                Matriz de transiciones comerciales (solo albaranes de salida, no terminales):
                  pending  → [Aprobar ✅] [Rechazar ❌]
                  approved → [Rechazar ❌] [Pendiente 🟠]
                  rejected → [Aprobar  ✅] [Pendiente 🟠]
            -->
            <xpath expr="//button[@name='button_validate'][1]" position="before">
                <button name="action_commercial_approve"
                        string="Aprobar"
                        type="object"
                        class="btn-success"
                        groups="sales_team.group_sale_salesman"
                        invisible="picking_type_code != 'outgoing'
                                   or commercial_validation == 'approved'
                                   or state in ['done', 'cancel']"/>
                <button name="action_commercial_reject"
                        string="Rechazar"
                        type="object"
                        class="btn-danger"
                        groups="sales_team.group_sale_salesman"
                        invisible="picking_type_code != 'outgoing'
                                   or commercial_validation == 'rejected'
                                   or state in ['done', 'cancel']"/>
                <button name="action_commercial_set_pending"
                        string="Pendiente"
                        type="object"
                        class="btn-warning"
                        groups="sales_team.group_sale_salesman"
                        invisible="picking_type_code != 'outgoing'
                                   or commercial_validation == 'pending'
                                   or state in ['done', 'cancel']"/>
            </xpath>

            <!-- Badge sin etiqueta en la esquina superior derecha del sheet -->
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="d-flex justify-content-end pe-2 pt-1"
                     invisible="picking_type_code != 'outgoing'">
                    <field name="commercial_validation"
                           widget="badge"
                           nolabel="1"
                           decoration-warning="commercial_validation == 'pending'"
                           decoration-success="commercial_validation == 'approved'"
                           decoration-danger="commercial_validation == 'rejected'"
                           readonly="1"/>
                </div>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         LIST VIEW — columna de validación comercial con badge de color
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_picking_tree_commercial_validation" model="ir.ui.view">
        <field name="name">stock.picking.tree.commercial.validation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="commercial_validation"
                       widget="badge"
                       optional="show"
                       column_invisible="context.get('default_picking_type_code') not in (False, 'outgoing')"
                       decoration-warning="commercial_validation == 'pending'"
                       decoration-success="commercial_validation == 'approved'"
                       decoration-danger="commercial_validation == 'rejected'"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════════
         SEARCH VIEW — filtros para gestión comercial
         ══════════════════════════════════════════════════════════════════════ -->
    <record id="view_picking_search_commercial_validation" model="ir.ui.view">
        <field name="name">stock.picking.search.commercial.validation</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='available']" position="after">
                <separator/>
                <filter name="commercial_priority_stock"
                        string="Con Stock Reservado (Prioridad)"
                        domain="[('picking_type_id.code', '=', 'outgoing'),
                                  ('commercial_validation', '=', 'pending'),
                                  ('state', '=', 'assigned')]"/>
                <filter name="commercial_pending"
                        string="Pendiente Aprobación Comercial"
                        domain="[('picking_type_id.code', '=', 'outgoing'),
                                  ('commercial_validation', '=', 'pending')]"/>
                <filter name="commercial_approved"
                        string="Aprobados Comercialmente"
                        domain="[('picking_type_id.code', '=', 'outgoing'),
                                  ('commercial_validation', '=', 'approved')]"/>
                <filter name="commercial_rejected"
                        string="Rechazados Comercialmente"
                        domain="[('picking_type_id.code', '=', 'outgoing'),
                                  ('commercial_validation', '=', 'rejected')]"/>
            </xpath>
        </field>
    </record>

</odoo>
