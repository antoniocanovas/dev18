<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_sale_order_export_shoes_excel" model="ir.actions.server">
        <field name="name">Export EAN and SALE LINES to Excel</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_shoes_excel()</field>
    </record>

    <record id="view_sale_order_form_shoes_export" model="ir.ui.view">
        <field name="name">sale.order.form.shoes.export</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[last()]" position="after">
                <button name="action_export_shoes_excel"
                        string="Export Excel"
                        type="object"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>

</odoo>
