<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_webhook_token_list" model="ir.ui.view">
        <field name="name">webhook.token.list</field>
        <field name="model">webhook.token</field>
        <field name="arch" type="xml">
            <list string="Tokens de Webhook">
                <field name="name"/>
                <field name="user_id"/>
                <field name="active"/>
                <field name="last_used"/>
                <field name="usage_count"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_webhook_token_form" model="ir.ui.view">
        <field name="name">webhook.token.form</field>
        <field name="model">webhook.token</field>
        <field name="arch" type="xml">
            <form string="Token de Webhook">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="active"/>
                        <field name="token" readonly="1"/>
                        <field name="expiry_date"/>
                        <field name="allowed_ips"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webhook_token" model="ir.actions.act_window">
        <field name="name">Tokens de Webhook</field>
        <field name="res_model">webhook.token</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_webhook_tokens" 
              name="Tokens de API Webhook" 
              parent="base.menu_custom"
              action="action_webhook_token"/>

</odoo>
