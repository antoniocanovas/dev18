<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Partner customization & migration fields : -->
    <record id="res_partner_navima_inh_form" model="ir.ui.view">
        <field name="name">res.partner.navima.inh.form</field>
        <field name="model">res.partner</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- ref en la misma línea que el selector individual/empresa -->
            <xpath expr="//div[hasclass('oe_title')]/field[@name='company_type']" position="replace">
                <div class="d-flex align-items-center gap-3">
                    <field name="company_type" widget="radio" options="{'horizontal': true}"/>
                    <span class="fs-4 fw-bold" style="color: #8b0000;" invisible="not ref">
                        <field name="ref" readonly="1" nolabel="1"/>
                    </span>
                </div>
            </xpath>

            <!-- Añadir campo de etiquetas imprimibles justo debajo del VAT -->
            <xpath expr="//sheet/group/group" position="inside">
                <field name="printed_label_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       placeholder='e.g. "NO PIG", "ECOLOGIC", "VIP", ...'
                       string="Etiquetas Imprimibles"
                       help="Etiquetas que aparecerán en los documentos impresos"/>
            </xpath>
            
            <!-- Campos de migración existentes -->
            <xpath expr="//notebook" position="inside">
                <page name="migration_page">
                    <group name="migration_fields">
                        <field name="mig_subcuenta"/>
                        <field name="mig_agente"/>
                        <field name="mig_inconterm"/>
                        <field name="mig_fpago"/>
                        <field name="mig_aseguradora"/>
                        <field name="mig_concedido"/>
                        <field name="mig_posicionfiscal"/>
                        <field name="mig_responsableinterno"/>
                        <field name="mig_provincia"/>
                        <field name="mig_vat"/>
                        <field name="mig_nombrecomercial"/>
                    </group>
                </page>
            </xpath>
        </field>
        <field name="priority">99</field>
    </record>

</odoo>