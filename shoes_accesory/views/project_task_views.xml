<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Task customization : -->
    <record id="shoes_accesory_task_inh_form" model="ir.ui.view">
        <field name="name">shoes.accesory.campaign.task.inh.form</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_campaign.shoes_campaign_task_inh_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='shoes_dealer_campaign']" position="after">
                    <group name="shoes_accesories" invisible="not is_shoes_campaign">
                        <field name="shoes_accesory_ids">
                            <list editable="bottom">
                                <field name="product_id"
                                    domain="[('type','=','consu'),('is_pair','=',False),('is_assortment','=',False)]"
                                />
                                <field name="qty"/>
                                <field name="task_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                </xpath>
            </data>
        </field>
        <field name="priority">99</field>
    </record>

</odoo>
