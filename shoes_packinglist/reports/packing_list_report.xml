<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_packing_list" model="ir.actions.report">
        <field name="name">Packing List</field>
        <field name="model">purchase.container</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">shoes_packinglist.packing_list_report</field>
        <field name="report_file">shoes_packinglist.packing_list_report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <template id="packing_list_report">
        <t t-call="web.html_container">

            <!-- ═══════════════════════════════════════════════════════════
                 PARTE 1 — Listado de cajas
                 Una página por cada (contenedor × partida arancelaria)
                 ═══════════════════════════════════════════════════════════ -->
            <t t-foreach="docs" t-as="doc">
                <t t-set="groups" t-value="doc._get_packing_list_report_data()"/>
                <t t-foreach="groups" t-as="group">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <h4 style="margin-bottom:4px;">
                                Packing List —
                                <t t-out="doc.name"/>
                                <t t-if="doc.shipping_agent_id">
                                    &amp;nbsp;·&amp;nbsp;<t t-out="doc.shipping_agent_id.display_name"/>
                                </t>
                                &amp;nbsp;—&amp;nbsp;
                                Partida arancelaria:
                                <t t-out="group['tariff_heading'] or 'Sin partida'"/>
                            </h4>

                            <table class="table table-sm table-bordered" style="font-size:8pt;width:100%;">
                                <thead style="background-color:#f0f0f0;">
                                    <tr>
                                        <th>Lote</th>
                                        <th>Marca</th>
                                        <th>Referencia</th>
                                        <th>Color</th>
                                        <th class="text-end">Bultos</th>
                                        <th class="text-end">P. Neto</th>
                                        <th class="text-end">P. Bruto</th>
                                        <th class="text-end">Pares</th>
                                        <th>Tallas y Cantidad</th>
                                        <th>Campaña</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="group['lines']" t-as="line">
                                        <t t-set="extra" t-value="line._get_report_extra()"/>
                                        <tr>
                                            <td><t t-out="line.lot or ''"/></td>
                                            <td><t t-out="extra['brand']"/></td>
                                            <td><t t-out="line.name or ''"/></td>
                                            <td><t t-out="extra['color']"/></td>
                                            <td class="text-end"><t t-out="int(line.quantity)"/></td>
                                            <td class="text-end"><t t-out="'%.3f' % line.assortment_net_weight"/></td>
                                            <td class="text-end"><t t-out="'%.3f' % line.assortment_gross_weight"/></td>
                                            <td class="text-end"><t t-out="int(line.pair_qty)"/></td>
                                            <td style="font-size:7pt;"><t t-out="extra['sizes']"/></td>
                                            <td><t t-out="extra['campaign']"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="background-color:#d0d0d0;">
                                        <td colspan="4" class="text-end"><strong>Subtotal</strong></td>
                                        <td class="text-end"><strong><t t-out="int(group['total_quantity'])"/></strong></td>
                                        <td class="text-end"><strong><t t-out="'%.3f' % group['total_net_weight']"/></strong></td>
                                        <td class="text-end"><strong><t t-out="'%.3f' % group['total_gross_weight']"/></strong></td>
                                        <td class="text-end"><strong><t t-out="int(group['total_pairs'])"/></strong></td>
                                        <td colspan="2"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </t>
                </t>
            </t>

            <!-- ═══════════════════════════════════════════════════════════
                 PARTE 2 — Resumen por partida arancelaria
                 Página nueva, datos agregados de todos los contenedores
                 ═══════════════════════════════════════════════════════════ -->
            <t t-set="summary" t-value="docs._get_packing_list_summary_data()"/>
            <t t-call="web.external_layout">
                <div class="page">
                    <h4 style="margin-bottom:6px;">Resumen por Partida Arancelaria</h4>

                    <table class="table table-sm table-bordered" style="font-size:9pt;width:100%;">
                        <thead style="background-color:#f0f0f0;">
                            <tr>
                                <th>Partida Arancelaria</th>
                                <th class="text-end">Bultos</th>
                                <th class="text-end">P. Neto</th>
                                <th class="text-end">P. Bruto</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Importe</th>
                                <th>Moneda</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="summary['groups']" t-as="sg">
                                <tr>
                                    <td><t t-out="sg['tariff_heading'] or 'Sin partida'"/></td>
                                    <td class="text-end"><t t-out="int(sg['quantity'])"/></td>
                                    <td class="text-end"><t t-out="'%.3f' % sg['net_weight']"/></td>
                                    <td class="text-end"><t t-out="'%.3f' % sg['gross_weight']"/></td>
                                    <td class="text-end"><t t-out="int(sg['pairs'])"/></td>
                                    <td class="text-end"><t t-out="'%.2f' % sg['amount']"/></td>
                                    <td><t t-out="sg['currency'].name if sg['currency'] else ''"/></td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot>
                            <tr style="background-color:#d0d0d0;">
                                <td><strong>TOTAL</strong></td>
                                <td class="text-end"><strong><t t-out="int(summary['total']['quantity'])"/></strong></td>
                                <td class="text-end"><strong><t t-out="'%.3f' % summary['total']['net_weight']"/></strong></td>
                                <td class="text-end"><strong><t t-out="'%.3f' % summary['total']['gross_weight']"/></strong></td>
                                <td class="text-end"><strong><t t-out="int(summary['total']['pairs'])"/></strong></td>
                                <td class="text-end"><strong><t t-out="'%.2f' % summary['total']['amount']"/></strong></td>
                                <td/>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>

        </t>
    </template>
</odoo>
