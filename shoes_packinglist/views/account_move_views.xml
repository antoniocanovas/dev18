<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_containers" model="ir.ui.view">
        <field name="name">account.move.form.containers</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <field
                    name="container_ids"
                    widget="many2many_tags"
                    readonly="1"
                    invisible="move_type not in ['in_invoice', 'in_refund']"
                    options="{'no_open': True, 'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
