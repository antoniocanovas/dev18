<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_packinglist" model="ir.ui.view">
        <field name="name">product.template.form.packinglist</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='volume']" position="after">
                <label for="width_length_high"/>
                <div class="o_row">
                    <field name="width_length_high"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
