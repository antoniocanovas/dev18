<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_lot_form_view_packinglist" model="ir.ui.view">
        <field name="name">stock.lot.form.packinglist</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='description']" position="after">
                <page string="Packing List" name="packing_list">
                    <group>
                        <group string="Pesos y volumen">
                            <field name="weight"/>
                            <field name="net_weight"/>
                            <field name="volume"/>
                        </group>
                        <group string="Dimensiones">
                            <field name="product_length"/>
                            <field name="product_height"/>
                            <field name="product_width"/>
                            <field name="dimensional_uom_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="container_line_id" readonly="1"/>
                        <field name="container_id" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
