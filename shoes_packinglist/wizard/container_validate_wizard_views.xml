<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="container_validate_wizard_view_form" model="ir.ui.view">
        <field name="name">container.validate.wizard.form</field>
        <field name="model">container.validate.wizard</field>
        <field name="arch" type="xml">
            <form string="Validar albaranes del contenedor">
                <sheet>
                    <group>
                        <field name="container_id" readonly="1"/>
                        <field name="location_dest_id"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_validate"
                        type="object"
                        string="Validar"
                        class="btn-primary"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
