<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_product_pricelist_inh_form" model="ir.ui.view">
        <field name="name">shoes.product.pricelist.inh.form</field>
        <field name="model">product.pricelist</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pricelist_config']" position="inside">
                <group name="pricelist_recalculation" string="Product prices recalculation">
                    <field name="shoes_campaign_id" required="1" widget="selection"/>
                    <field name="margin" />
                    <field name="currency_exchange" />
                </group>
                <group attrs="{'invisible':['|',('shoes_campaign_id','=',False)]}">
                    <button class="oe_highlight"
                            type="object"
                            name="products_pricelist_recalculation_by_campaign"
                            string="Recalculate"/>
                </group>
                <group name="product_template_in_pricelist">
                    <field name="product_tmpl_ids" groups="base.group_no_one"/>
                </group>
            </xpath>

            <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                <page string="Pairs" name="pairs_pricelist">
                    <field name="product_tmpl_item_ids">
                        <list>
                            <field name="product_tmpl_id"/>
                            <field name="price"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
