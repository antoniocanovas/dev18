<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view for purchase.order.line used in the split wizard add-line dialog.
         priority=10 so it takes precedence over the base purchase view (priority=16).
         The OCA menu action is unaffected because it specifies view_id explicitly. -->
    <record id="purchase_order_line_list_split" model="ir.ui.view">
        <field name="name">purchase.order.line.list.split</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <list string="Líneas de pedido">
                <field name="product_id" string="Artículo"/>
                <field name="sale_order_id" string="Pedido de venta"/>
                <field name="pnt_sale_type_id" string="Shipping Mark"/>
                <field name="product_qty" string="Cantidad"/>
                <field name="price_unit" string="Precio unit."/>
            </list>
        </field>
    </record>

    <!-- Extend the base purchase search view to add group-by and search options.
         Being an extension (mode=extension, the default), these changes apply to:
           - the base view itself  → used by the "Add a line" dialog (priority=16)
           - the OCA primary variant → built on top of the extended base arch -->
    <record id="purchase_order_line_search_split" model="ir.ui.view">
        <field name="name">purchase.order.line.search.split</field>
        <field name="model">purchase.order.line</field>
        <field name="inherit_id" ref="purchase.purchase_order_line_search"/>
        <field name="arch" type="xml">
            <!-- Add search fields after the existing partner_id field -->
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sale_order_id" string="Pedido de venta"/>
                <field name="pnt_sale_type_id" string="Shipping Mark"/>
            </xpath>
            <!-- Add group-by options inside the existing Group By section -->
            <xpath expr="//group" position="inside">
                <separator/>
                <filter string="Pedido de venta" name="groupby_sale_order"
                        context="{'group_by': 'sale_order_id'}"/>
                <filter string="Shipping Mark" name="groupby_shippingmark"
                        context="{'group_by': 'pnt_sale_type_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_split_wizard_form" model="ir.ui.view">
        <field name="name">purchase.split.wizard.form</field>
        <field name="model">purchase.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Dividir pedido de compra">
                <sheet>
                    <group>
                        <field name="purchase_order_id" readonly="1"/>
                    </group>
                    <separator string="Líneas a conservar en el pedido original"/>
                    <field name="line_ids"
                           nolabel="1"
                           domain="[('order_id', '=', purchase_order_id)]">
                        <list string="Líneas a conservar">
                            <field name="product_id"/>
                            <field name="sale_order_id" string="Pedido de venta" optional="show"/>
                            <field name="pnt_sale_type_id" string="Shipping Mark" optional="show"/>
                            <field name="product_qty" string="Cantidad"/>
                            <field name="price_unit" string="Precio unit."/>
                            <field name="pairs_count" string="Pares" optional="show"/>
                        </list>
                    </field>
                    <div class="alert alert-info mt-2" role="alert">
                        Las líneas <strong>no seleccionadas</strong> del pedido original
                        pasarán al nuevo pedido de compra.
                    </div>
                </sheet>
                <footer>
                    <button string="Dividir pedido"
                            name="action_split"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
