<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Shoes Lasts customization: -->
    <record id="shoes_color_chart_shoes_last_inh_form" model="ir.ui.view">
        <field name="name">shoes.color.chart.shoes.last.inh.form</field>
        <field name="model">shoes.last</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_dealer.shoes_last_default_form"/>
        <field name="arch" type="xml">

            <field name="description" position="after">
                <field name="project_auxiliar_material_id" invisible="1"/>
            </field>

            <!-- Dominios para permitir sólo productos secundarios para marketing: -->
            <xpath expr="//field[@name='sole_material_main_id']" position="attributes">
                <attribute name="domain">['|',('shoes_campaign_ids','in',project_auxiliar_material_id),('shoes_campaign_ids','=',False)]</attribute>>
            </xpath>
            <xpath expr="//field[@name='sole_material_secondary_id']" position="attributes">
                <attribute name="domain">['|',('shoes_campaign_ids','in',project_auxiliar_material_id),('shoes_campaign_ids','=',False)]</attribute>>
            </xpath>
            <xpath expr="//field[@name='insole_material_id']" position="attributes">
                <attribute name="domain">['|',('shoes_campaign_ids','in',project_auxiliar_material_id),('shoes_campaign_ids','=',False)]</attribute>>
            </xpath>
            <xpath expr="//field[@name='platform_material_id']" position="attributes">
                <attribute name="domain">['|',('shoes_campaign_ids','in',project_auxiliar_material_id),('shoes_campaign_ids','=',False)]</attribute>>
            </xpath>
        </field>

        <field name="priority">99</field>
    </record>

</odoo>
