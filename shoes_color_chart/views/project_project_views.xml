<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Normal project view : PENDIENTE DE AÑADIR EL DOMINIO !!! -->
    <record id="shoes_color_chart_project_inh_form" model="ir.ui.view">
        <field name="name">shoes.color.chart.project.inh.form</field>
        <field name="model">project.project</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button
                        name="%(shoes_color_chart_wizard_act_window)s"
                        invisible="not is_shoes_campaign"
                        string="Color Chart"
                        groups="project.group_project_manager"
                        type="action"
                />
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" icon="fa-diamond" type="action"
                        name="shoes_color_chart.shoes_color_chart_item_act_window">
                    <field widget="statinfo" name="shoes_color_chart_item_count" string="Chart items"/>
                </button>
            </xpath>

            <xpath expr="//page[@name='description']" position="after">
                <page name="shoes_color_chart" string="Color Chart">
                    <field name="shoes_color_chart_item_ids">
                        <list>
                            <field name="name"/>
                            <field name="color_value_id"/>
                            <field name="manufacturer_id"/>
                            <field name="material_id"/>
                            <field name="shoes_campaign_id" invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>

</odoo>