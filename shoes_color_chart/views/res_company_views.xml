<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="shoes_color_chart_inh_form" model="ir.ui.view">
        <field name="name">shoes.color.chart.inh.form</field>
        <field name="model">res.company</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_dealer.shoes_dealer_inh_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='single_prefix']" position="after">
                <field name="project_auxiliar_material_id"/>
            </xpath>
        </field>
    </record>

</odoo>
