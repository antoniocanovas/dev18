<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ACCION DE VENTANA desde proyectos: -->
    <record id="shoes_color_chart_item_act_window" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="context">{'default_shoes_campaign_id':active_id}</field>
        <field name="domain">[('shoes_campaign_id','=',active_id)]</field>
        <field name="filter" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="limit">80</field>
        <field name="name">Color Chart</field>
        <field name="res_model">shoes.color.chart.item</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ACCION DE VENTANA desde SHOES DEALER (agrupada por campañas): -->
    <record id="shoes_color_chart_item_config_menu_act_window" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="context">{'group_by': 'shoes_campaign_id'}</field>
        <field name="domain">[]</field>
        <field name="filter" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="limit">80</field>
        <field name="name">Color Chart</field>
        <field name="res_model">shoes.color.chart.item</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- FORM VIEW: -->
    <record id="shoes_color_chart_item_default_form" model="ir.ui.view">
        <field name="name">shoes.color.chart.item.default.form</field>
        <field name="model">shoes.color.chart.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Color chart item ..." required="1"/>
                    </h1>
                    <group>
                        <field name="color_value_id" required="1" domain="[('attribute_id','=',color_attribute_id)]" options="{'no_create':true, 'no_create_edit':true}"/>
                        <field name="manufacturer_id" required="1" options="{'no_create':true, 'no_create_edit':true}"/>
                        <field name="material_id" required="1" options="{'no_create':true, 'no_create_edit':true}"/>
                        <field name="shoes_campaign_id" readonly="1" options="{'no_create':true, 'no_create_edit':true}"/>
                        <field name="color_attribute_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">form</field>
    </record>

    <!-- list VIEW: -->
    <record id="shoes_color_chart_item_default_tree" model="ir.ui.view">
        <field name="name">shoes.color.chart.item.default.list</field>
        <field name="model">shoes.color.chart.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color_value_id"/>
                <field name="manufacturer_id"/>
                <field name="material_id"/>
                <field name="shoes_campaign_id" optional="hide"/>
            </list>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">list</field>
    </record>

    <!-- search VIEW: -->
    <record id="shoes_color_chart_item_default_search" model="ir.ui.view">
        <field name="name">shoes.color.chart.item.default.search</field>
        <field name="model">shoes.color.chart.item</field>
        <field name="arch" type="xml">
            <search string="Chart items">
                <field name="shoes_campaign_id" string="Campaign" filter_domain="[('shoes_campaign_id', 'ilike', self)]"/>
                <field name="manufacturer_id" string="Manufacturer" filter_domain="[('manufacturer_id', 'ilike', self)]"/>
                <field name="material_id" string="Material" filter_domain="[('material_id', 'ilike', self)]"/>
                <field name="color_value_id" string="Color" filter_domain="[('color_value_id', 'ilike', self)]"/>
                <group expand="0" string="Group By">
                    <filter string="Campaign" name="campaign_group" context="{'group_by': 'shoes_campaign_id'}"/>
                    <filter string="Manufacturer" name="manufacturer_group" context="{'group_by': 'manufacturer_id'}"/>
                    <filter string="Material" name="material_group" context="{'group_by': 'material_id'}"/>
                    <filter string="Color" name="color_group" context="{'group_by': 'color_value_id'}"/>
                </group>
            </search>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">search</field>
    </record>

    <!-- SHOES COLOR CHART CONFIG MENU: -->
    <record id="shoes_color_chart_item_menu" model="ir.ui.menu">
        <field name="action" ref="shoes_color_chart_item_config_menu_act_window"/>
        <field name="active" eval="True"/>
        <field name="name">Color charts</field>
        <field name="parent_id" ref="shoes_dealer.shoes_dealer_configuration_details"/>
        <field name="sequence">200</field>
        <field name="web_icon" eval="False"/>
    </record>

</odoo>
