<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- ACCION DE VENTANA: -->
    <record id="shoes_color_chart_item_act_window" model="ir.actions.act_window">
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="context">{'default_shoes_campaign_id':active_id}</field>
        <field name="domain">[('shoes_campaign_id','=',active_id)]</field>
        <field name="filter" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="limit">80</field>
        <field name="name">Color Chart</field>
        <field name="res_model">shoes.color.chart.item</field>
        <field name="search_view_id" eval="False"/>
        <field name="target">current</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- FORM VIEW: -->
    <record id="shoes_color_chart_item_default_form" model="ir.ui.view">
        <field name="name">shoes.color.chart.item.default.form</field>
        <field name="model">shoes.color.chart.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Color chart item ..."/>
                    </h1>
                    <group>
                        <field name="color_value_id"/>
                        <field name="manufacturer_id"/>
                        <field name="material_id"/>
                        <field name="shoes_campaign_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">form</field>
    </record>

    <!-- list VIEW: -->
    <record id="shoes_color_chart_item_default_tree" model="ir.ui.view">
        <field name="name">shoes.color.chart.item.default.list</field>
        <field name="model">shoes.color.chart.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color_value_id"/>
                <field name="manufacturer_id"/>
                <field name="material_id"/>
                <field name="shoes_campaign_id" optional="hide"/>
            </list>
        </field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="inherit_id" eval="False"/>
        <field name="key" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority">16</field>
        <field name="type">list</field>
    </record>

</odoo>
