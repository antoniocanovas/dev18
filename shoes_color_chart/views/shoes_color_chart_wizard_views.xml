<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="shoes_color_chart_wizard_form" model="ir.ui.view">
        <field name="name">shoes.color.chart.wizard.form</field>
        <field name="model">shoes.color.chart.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="color_attribute_id" invisible="True" />
                    <field name="manufacturer_id" />
                    <field name="material_id" />
                    <field name="color_value_ids" />
                </group>
                <footer>
                <button
                        name="action_apply"
                        class="btn btn-primary"
                        string="Color Chart"
                        type="object"
                    />
                or
                <button special="cancel" class="btn btn-secondary" string="Cancel" />
            </footer>
            </form>
        </field>
    </record>

    <record id="shoes_color_chart_wizard_act_window" model="ir.actions.act_window">
        <field name="name">Color Chart</field>
        <field name="res_model">shoes.color.chart.wizard</field>
        <field name="view_id" ref="shoes_color_chart_wizard_form" />
        <field name="target">new</field>
    </record>

</odoo>
