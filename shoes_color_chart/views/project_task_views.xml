<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Task customization (NO SE USA, QUITAR !!!): -->
    <record id="shoes_color_chart_task_inh_form" model="ir.ui.view">
        <field name="name">shoes.color.chart.task.inh.form</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_campaign.shoes_campaign_task_inh_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='manufacturer_id']" position="attributes">
                <attribute name="domain">[('id','in',manufacturer_value_ids)]</attribute>
            </xpath>
            <xpath expr="//field[@name='material_id']" position="attributes">
                <attribute name="domain">[('id','in',material_value_ids)]</attribute>
            </xpath>

            <field name="description" position="after">
                <field name="manufacturer_value_ids" invisible="0"/>
                <field name="material_value_ids" invisible="0"/>
                <field name="color_value_ids" invisible="0"/>
            </field>
        </field>
        <field name="priority">99</field>
    </record>

</odoo>
