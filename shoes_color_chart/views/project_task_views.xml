<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- Task customization : -->
    <record id="shoes_color_chart_task_inh_form" model="ir.ui.view">
        <field name="name">shoes.color.chart.task.inh.form</field>
        <field name="model">project.task</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_campaign.shoes_campaign_task_inh_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='manufacturer_id']" position="before">
                <field name="shoes_color_chart_id"
                       domain="[('shoes_campaign_id','=','project_id')]"
                       invisible="not is_shoes_campaign"
                />
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>

</odoo>
