<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <!-- VISTA FORM: -->
    <record id="shoes_color_chart_product_inh_form" model="ir.ui.view">
        <field name="name">product.shoes.color.chart.inh.form</field>
        <field name="model">product.template</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="shoes_dealer.shoes_dealer_product_inh_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- En Pestaña inicial para datos generales: -->
            <xpath expr="//field[@name='manufacturer_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='material_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    # Vistas FORM; la vista común para PP y PT:
    <record id="shoes_color_chart_pavfilter_inh_form_view" model="ir.ui.view">
        <field name="name">shoes.color.chart.pavfilter.inh.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="update_color_values_from_campaign_chart_colors"
                        icon="fa-spinner" class="oe_stat_button"
                        type="object" string="Upd Colors"
                        invisible="not shoes_campaign_id">
                </button>
            </xpath>

            <xpath expr="//field[@name='value_count']" position="after">
                <field name="campaign_value_ids" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='value_ids']" position="attributes">
                <attribute name="domain">[('attribute_id','=',attribute_id), ('id','in',campaign_value_ids)]</attribute>
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>
    -->

</odoo>