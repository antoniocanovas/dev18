        <field name="name">shoes.color.chart.pavfilter.inh.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='value_count']" position="after">
                <field name="color_value_ids" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='value_ids']" position="attributes">
                <attribute name="domain">[('attribute_id','=',attribute_id), '|', ('id','in',color_value_ids)]</attribute>
            </xpath>

        </field>
        <field name="priority">99</field>
    </record>
    -->

</odoo>